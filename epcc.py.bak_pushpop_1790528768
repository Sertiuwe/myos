#!/usr/bin/env python3
"""epcc.py — C -> EP32cm bytecode. Подмножество: int, while/if/for, builtins."""
import sys, re
from epc_asm import Emitter

# =============== LEXER ===============
def tokenize(src):
    src = re.sub(r'//[^\n]*', '', src)
    src = re.sub(r'/\*.*?\*/', '', src, flags=re.DOTALL)
    pat = re.compile(r'\s+|0[xX][0-9a-fA-F]+|\d+|[A-Za-z_]\w*'
                     r'|<<|>>|<=|>=|==|!=|&&|\|\||[-+*/%&|^<>=!(){},;]')
    out = []
    for m in pat.finditer(src):
        t = m.group()
        if not t[0].isspace():
            out.append(t)
    out.append('<EOF>')
    return out

# =============== PARSER ===============
class P:
    def __init__(self, toks): self.t = toks; self.i = 0
    def peek(self): return self.t[self.i]
    def eat(self, want=None):
        t = self.t[self.i]
        if want is not None and t != want:
            raise SyntaxError(f'expected {want!r}, got {t!r}')
        self.i += 1
        return t
    def at(self, *vals): return self.peek() in vals

    def program(self):
        body = []
        while self.peek() != '<EOF>':
            body.append(self.stmt())
        return ('prog', body)

    def stmt(self):
        t = self.peek()
        if t == '{': return self.block()
        if t == 'int': return self.decl()
        if t == 'if': return self.if_stmt()
        if t == 'while': return self.while_stmt()
        if t == 'for': return self.for_stmt()
        e = self.expr()
        self.eat(';')
        return ('expr', e)

    def block(self):
        self.eat('{'); body = []
        while self.peek() != '}': body.append(self.stmt())
        self.eat('}')
        return ('block', body)

    def decl(self):
        self.eat('int'); name = self.eat()
        init = None
        if self.at('='):
            self.eat('='); init = self.expr()
        self.eat(';')
        return ('decl', name, init)

    def if_stmt(self):
        self.eat('if'); self.eat('('); c = self.expr(); self.eat(')')
        th = self.stmt()
        el = None
        if self.at('else'):
            self.eat('else'); el = self.stmt()
        return ('if', c, th, el)

    def while_stmt(self):
        self.eat('while'); self.eat('('); c = self.expr(); self.eat(')')
        return ('while', c, self.stmt())

    def for_stmt(self):
        self.eat('for'); self.eat('(')
        init = None
        if not self.at(';'): init = self.stmt()
        else: self.eat(';')
        cond = None
        if not self.at(';'): cond = self.expr()
        self.eat(';')
        step = None
        if not self.at(')'): step = self.expr()
        self.eat(')')
        return ('for', init, cond, step, self.stmt())

    # expressions: parse_assign -> ... -> parse_primary
    def expr(self):
        # assignment (right-assoc, only to bare id)
        if self.peek() != '<EOF>' and re.match(r'^[A-Za-z_]\w*$', self.peek()):
            save = self.i
            name = self.eat()
            if self.at('='):
                self.eat('=')
                return ('assign', name, self.expr())
            self.i = save
        return self.binary(0)

    # precedence climbing
    PRE = { '||':1, '&&':2, '|':3, '^':4, '&':5,
            '==':6, '!=':6, '<':7, '>':7, '<=':7, '>=':7,
            '<<':8, '>>':8, '+':9, '-':9, '*':10, '/':10, '%':10 }
    def binary(self, minp):
        left = self.unary()
        while True:
            op = self.peek()
            p = self.PRE.get(op, -1)
            if p < minp: break
            self.eat()
            right = self.binary(p + 1)
            left = ('bin', op, left, right)
        return left

    def unary(self):
        if self.at('-', '!', '~'):
            op = self.eat()
            return ('un', op, self.unary())
        return self.prim()

    def prim(self):
        t = self.eat()
        if re.match(r'^0[xX][0-9a-fA-F]+$|^\d+$', t):
            return ('num', int(t, 0))
        if t == '(':
            e = self.expr(); self.eat(')'); return e
        if re.match(r'^[A-Za-z_]\w*$', t):
            if self.at('('):
                self.eat('('); args = []
                if not self.at(')'):
                    args.append(self.expr())
                    while self.at(','):
                        self.eat(','); args.append(self.expr())
                self.eat(')')
                return ('call', t, args)
            return ('id', t)
        raise SyntaxError(f'unexpected {t!r}')

# =============== CODEGEN ===============
GLOBAL_BASE = 0x4000
EXPR_SP     = 0x7FF0

class CG:
    def __init__(self): self.e = Emitter(); self.g = {}; self.n = 0
    def lbl(self, p='L'): self.n += 1; return f'{p}{self.n}'
    def goff(self, name):
        if name not in self.g: raise NameError(f'undefined: {name}')
        return self.g[name] * 4

    def push(self):
        self.e.stl(7, 0, 0)      # STL [R7+0], R0
        self.e.subi(7, 4)        # R7 -= 4
    def pop(self, dst):
        self.e.ldl(dst, 7, 0)    # R{dst} = [R7]
        self.e.addi(7, 4)        # R7 += 4

    def gen(self, n):
        k = n[0]
        if k == 'num':
            self.e.movi(0, n[1] & 0xFFFFF); return
        if k == 'id':
            self.e.ldl(0, 6, self.goff(n[1])); return
        if k == 'assign':
            self.gen(n[2])
            self.e.stl(6, 0, self.goff(n[1])); return
        if k == 'un':
            op, x = n[1], n[2]; self.gen(x)
            if op == '-':
                self.e.movi(1, 0); self.e.sub(0, 1, 0)
            elif op == '~':
                self.e.not_(0, 0)
            elif op == '!':
                t = self.lbl('nt'); e = self.lbl('ne')
                self.e.cmpi(0, 0); self.e.jz(t)
                self.e.movi(0, 0); self.e.jmp(e)
                self.e.label(t); self.e.movi(0, 1)
                self.e.label(e)
            return
        if k == 'bin':
            op, l, r = n[1], n[2], n[3]
            if op == '&&':
                # short-circuit: (l!=0) && (r!=0)
                self.gen(l); self.e.cmpi(0, 0)
                f = self.lbl('and_f'); e = self.lbl('and_e')
                self.e.jz(f)
                self.gen(r); self.e.cmpi(0, 0)
                self.e.jz(f)
                self.e.movi(0, 1); self.e.jmp(e)
                self.e.label(f); self.e.movi(0, 0)
                self.e.label(e)
                return
            if op == '||':
                t = self.lbl('or_t'); e = self.lbl('or_e')
                self.gen(l); self.e.cmpi(0, 0)
                self.e.jnz(t)
                self.gen(r); self.e.cmpi(0, 0)
                self.e.jnz(t)
                self.e.movi(0, 0); self.e.jmp(e)
                self.e.label(t); self.e.movi(0, 1)
                self.e.label(e)
                return
            # regular binary
            self.gen(l); self.push()
            self.gen(r); self.pop(1)     # R1 = left, R0 = right
            if op == '+':   self.e.add(0, 1, 0)
            elif op == '-': self.e.sub(0, 1, 0)
            elif op == '*': self.e.mul(0, 1, 0)
            elif op == '/': self.e.div(0, 1, 0)
            elif op == '%': self.e.mod(0, 1, 0)
            elif op == '&': self.e.and_(0, 1, 0)
            elif op == '|': self.e.or_(0, 1, 0)
            elif op == '^': self.e.xor(0, 1, 0)
            elif op == '<<': self.e.shl(0, 1, 0)
            elif op == '>>': self.e.shr(0, 1, 0)
            elif op in ('==', '!=', '<', '>', '<=', '>='):
                self.e.cmp(1, 0)        # flags = R1 - R0
                t = self.lbl('ct'); e = self.lbl('ce')
                jmp_true = { '==':'jz', '!=':'jnz',
                             '<':'jlt', '>':'jgt', '<=':'jle', '>=':'jge' }[op]
                getattr(self.e, jmp_true)(t)
                self.e.movi(0, 0); self.e.jmp(e)
                self.e.label(t); self.e.movi(0, 1)
                self.e.label(e)
            else: raise ValueError(f'op {op}')
            return
        if k == 'call':
            name, args = n[1], n[2]
            if name == 'out':
                self.gen(args[1])
                port = args[0][1] if args[0][0] == 'num' else 0
                self.e.out(port & 0xF, 0); return
            if name == 'in':
                port = args[0][1] if args[0][0] == 'num' else 0
                self.e.in_(0, port & 0xF); return
            if name == 'irq':
                nn = args[0][1] if args[0][0] == 'num' else 0
                self.e.irq(nn & 0xF); self.e.movi(0, 0); return
            if name == 'hlt':
                self.e.hlt(); self.e.movi(0, 0); return
            if name == 'nop':
                self.e.nop(); self.e.movi(0, 0); return
            raise NameError(f'unknown fn: {name}')
        raise ValueError(f'gen: {k}')

    def stmt(self, n):
        k = n[0]
        if k == 'prog':
            for s in n[1]: self.stmt(s)
            return
        if k == 'block':
            for s in n[1]: self.stmt(s)
            return
        if k == 'decl':
            name, init = n[1], n[2]
            if name not in self.g: self.g[name] = len(self.g)
            if init is not None:
                self.gen(init)
                self.e.stl(6, 0, self.goff(name))
            return
        if k == 'expr':
            self.gen(n[1]); return
        if k == 'if':
            cond, th, el = n[1], n[2], n[3]
            eLbl = self.lbl('el'); end = self.lbl('ie')
            self.gen(cond); self.e.cmpi(0, 0)
            self.e.jz(eLbl if el else end)
            self.stmt(th)
            if el:
                self.e.jmp(end); self.e.label(eLbl); self.stmt(el)
            self.e.label(end); return
        if k == 'while':
            cond, body = n[1], n[2]
            top = self.lbl('wt'); end = self.lbl('we')
            self.e.label(top)
            self.gen(cond); self.e.cmpi(0, 0); self.e.jz(end)
            self.stmt(body)
            self.e.jmp(top); self.e.label(end); return
        if k == 'for':
            init, cond, step, body = n[1], n[2], n[3], n[4]
            if init: self.stmt(init)
            top = self.lbl('ft'); end = self.lbl('fe')
            self.e.label(top)
            if cond:
                self.gen(cond); self.e.cmpi(0, 0); self.e.jz(end)
            self.stmt(body)
            if step: self.gen(step)
            self.e.jmp(top); self.e.label(end); return
        raise ValueError(f'stmt: {k}')

def compile_src(src):
    ast = P(tokenize(src)).program()
    cg = CG()
    cg.e.movi(6, GLOBAL_BASE)
    cg.e.movi(7, EXPR_SP)
    cg.stmt(ast)
    cg.e.hlt()
    return cg.e.hex()

def main():
    if len(sys.argv) < 2:
        print('usage: python3 epcc.py <input.c> [output.hex]')
        return
    hex_out = compile_src(open(sys.argv[1]).read())
    if len(sys.argv) >= 3:
        open(sys.argv[2], 'w').write(hex_out + '\n')
        print(f'OK: {len(hex_out)//8} words -> {sys.argv[2]}')
    else:
        print(hex_out)

if __name__ == '__main__':
    main()
