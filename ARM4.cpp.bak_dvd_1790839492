static inline uint32_t mmu_xlate(Memory* /*m*/, uint32_t a, bool write, bool& fault,
                                   bool fetch = false) {
    fault = false;
    if (!g_cp15_ptr || !g_cp15_ptr->mmu_on()) return a;
    if (a >= 0x10000000u && a < 0x10200000u) return a;   // MMIO
    if (a >= 0xF0000000u && a < 0xF0001000u) return a;   // ports
    // User-доступ если CPU в User mode
    bool user = false;
    if (g_cpu_ptr) {
        Mode m = g_cpu_ptr->cpsr.mode();
        user = (m == Mode::User);
    }
    int code = 0;
    return g_mmu_ptr->translate(a, write, user, fetch, fault, code, *g_cp15_ptr);
}

uint32_t Memory::read32(uint32_t a) {
    if (ports && PortManager::is_port(a)) return ports->read(a, 4);
    {
        bool f = false;
        uint32_t pa = mmu_xlate(this, a, false, f, false);
        if (f) { flag_fault(a, false); return 0; }
        a = pa;
    }
    if (emu) {
        if (emu->vic.contains(a))    return emu->vic.read(a, 4);
        if (emu->uart0.contains(a))  return emu->uart0.read(a, 4);
        if (emu->uart1.contains(a))  return emu->uart1.read(a, 4);
        if (emu->uart2.contains(a))  return emu->uart2.read(a, 4);
        if (emu->timer0.contains(a)) return emu->timer0.read(a, 4);
        if (emu->timer1.contains(a)) return emu->timer1.read(a, 4);
        if (emu->gpio0.contains(a))  return emu->gpio0.read(a, 4);
        if (emu->gpio1.contains(a))  return emu->gpio1.read(a, 4);
        if (emu->net.contains(a))    return emu->net.read(a, 4);
        if (emu->eth.contains(a))    return emu->eth.read(a, 4);
        if (emu->vmcu.contains(a))   return emu->vmcu.read(a, 4);
        if (emu->lcd.contains(a))    return emu->lcd.read(a, 4);
    }
    if (!valid32(a)) { flag_fault(a, false); return 0; }
    // shared ARM4<->VMCU регион 0x70000-0x70FFF — без кеша
    if (a >= 0x70000 && a < 0x71000) {
        if (!valid32(a)) { flag_fault(a, false); return 0; }
        uint32_t v; std::memcpy(&v, &data[a], 4); return v;
    }
    return dcache.read32(a);
}
uint16_t Memory::read16(uint32_t a) {
    if (ports && PortManager::is_port(a)) return (uint16_t)ports->read(a, 2);
    {
        bool f = false;
        uint32_t pa = mmu_xlate(this, a, false, f, false);
        if (f) { flag_fault(a, false); return 0; }
        a = pa;
    }
    if (emu) {
        if (emu->vic.contains(a))    return (uint16_t)emu->vic.read(a, 2);
        if (emu->uart0.contains(a))  return (uint16_t)emu->uart0.read(a, 2);
        if (emu->uart1.contains(a))  return (uint16_t)emu->uart1.read(a, 2);
        if (emu->uart2.contains(a))  return (uint16_t)emu->uart2.read(a, 2);
        if (emu->timer0.contains(a)) return (uint16_t)emu->timer0.read(a, 2);
        if (emu->timer1.contains(a)) return (uint16_t)emu->timer1.read(a, 2);
        if (emu->gpio0.contains(a))  return (uint16_t)emu->gpio0.read(a, 2);
        if (emu->gpio1.contains(a))  return (uint16_t)emu->gpio1.read(a, 2);
        if (emu->net.contains(a))    return (uint16_t)emu->net.read(a, 2);
        if (emu->eth.contains(a))    return (uint16_t)emu->eth.read(a, 2);
        if (emu->vmcu.contains(a))   return (uint16_t)emu->vmcu.read(a, 2);
        if (emu->lcd.contains(a))    return (uint16_t)emu->lcd.read(a, 2);
    }
    if (!valid16(a)) { flag_fault(a, false); return 0; }
    if (a >= 0x70000 && a < 0x71000) {
        uint16_t v; std::memcpy(&v, &data[a], 2); return v;
    }
    return dcache.read16(a);
}
uint32_t Memory::read32_ic(uint32_t a) {
    if (g_cp15_ptr && g_cp15_ptr->mmu_on()) {
        bool f = false;
        uint32_t pa = mmu_xlate(this, a, false, f, true);
        if (f) { flag_fault(a, false); return 0; }
