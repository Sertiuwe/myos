                };
                for (int y = 0; y < 240; y++)
                    for (int x = 0; x < 320; x++) {
                        int b = x * 7 / 320;
                        uint16_t c = bars[b];
                        std::memcpy(emu.mem.data.data() + L.upbase + y*640 + x*2, &c, 2);
                    }
                L.init_term(); L.last_hash = 0xFFFFFFFFu; L.render();
                std::fprintf(stderr, "LCD bars, frames=%llu\n",
                            (unsigned long long)L.renders);
                return false;
            }
            if (std::strcmp(arg1, "pixel") == 0) {
                char xs[16]={0}, ys[16]={0}, cs[16]={0};
                std::sscanf(line_str.c_str(), "%*s %*s %15s %15s %15s", xs, ys, cs);
                if (!xs[0] || !ys[0] || !cs[0]) {
                    std::fprintf(stderr, "lcd pixel <x> <y> <rgb565>\n"); return false;
                }
                int x = std::atoi(xs), y = std::atoi(ys);
                uint16_t c = (uint16_t)parse_u32(cs);
                if (x < 0 || x >= 320 || y < 0 || y >= 240) return false;
                std::memcpy(emu.mem.data.data() + L.upbase + y*640 + x*2, &c, 2);
                return false;
            }
            // ==================== Плазма ====================
            if (std::strcmp(arg1, "plasma") == 0) {
                float t = arg2[0] ? std::strtof(arg2, nullptr) : 0.0f;
                for (int y = 0; y < 240; y++) {
                    for (int x = 0; x < 320; x++) {
                        float fx = (float)x / 32.0f;
                        float fy = (float)y / 32.0f;
                        float v =
                            std::sin(fx + t) +
                            std::sin(fy * 0.7f + t * 1.3f) +
                            std::sin((fx + fy) * 0.5f + t * 0.7f) +
                            std::sin(std::sqrt((fx-5)*(fx-5) + (fy-3.75f)*(fy-3.75f))
                                     * 1.5f + t * 1.1f);
                        // v in [-4..4], нормализуем
                        int r = (int)((std::sin(v * 3.14159f) * 0.5f + 0.5f) * 31);
                        int g = (int)((std::sin(v * 3.14159f + 2.094f) * 0.5f + 0.5f) * 63);
                        int b = (int)((std::sin(v * 3.14159f + 4.188f) * 0.5f + 0.5f) * 31);
                        uint16_t c = (uint16_t)((r << 11) | (g << 5) | b);
                        std::memcpy(emu.mem.data.data() + L.upbase + y*640 + x*2, &c, 2);
                    }
                }
                L.init_term(); L.last_hash = 0xFFFFFFFFu; L.render();
                std::fprintf(stderr, "LCD plasma t=%.2f, frames=%llu\n",
                            (double)t, (unsigned long long)L.renders);
                return false;
            }
            // ==================== Анимация плазмы ====================
            if (std::strcmp(arg1, "anim") == 0) {
                int frames = arg2[0] ? std::atoi(arg2) : 30;
                if (frames < 1) frames = 1;
                if (frames > 300) frames = 300;
                for (int f = 0; f < frames; f++) {
                    float t = f * 0.15f;
                    for (int y = 0; y < 240; y++) {
                        for (int x = 0; x < 320; x++) {
                            float fx = (float)x / 32.0f;
                            float fy = (float)y / 32.0f;
                            float v =
                                std::sin(fx + t) +
                                std::sin(fy * 0.7f + t * 1.3f) +
                                std::sin((fx + fy) * 0.5f + t * 0.7f) +
                                std::sin(std::sqrt((fx-5)*(fx-5) + (fy-3.75f)*(fy-3.75f))
                                         * 1.5f + t * 1.1f);
                            int r = (int)((std::sin(v * 3.14159f) * 0.5f + 0.5f) * 31);
                            int g = (int)((std::sin(v * 3.14159f + 2.094f) * 0.5f + 0.5f) * 63);
                            int b = (int)((std::sin(v * 3.14159f + 4.188f) * 0.5f + 0.5f) * 31);
                            uint16_t c = (uint16_t)((r << 11) | (g << 5) | b);
                            std::memcpy(emu.mem.data.data() + L.upbase + y*640 + x*2, &c, 2);
                        }
                    }
                    L.last_hash = 0xFFFFFFFFu;
                    L.render();
                }
                std::fprintf(stderr, "LCD anim %d \u043a\u0430\u0434\u0440\u043e\u0432, frames=%llu\n",
                            frames, (unsigned long long)L.renders);
                return false;
            }
            // ==================== Мандельброт ====================
            if (std::strcmp(arg1, "mandel") == 0) {
                /* mandel [zoom] [cx] [cy] */
                char za[32]={0}, xa[32]={0}, ya[32]={0};
                std::sscanf(line_str.c_str(), "%*s %*s %31s %31s %31s", za, xa, ya);
                float zoom = za[0] ? std::strtof(za, nullptr) : 1.0f;
                float cx   = xa[0] ? std::strtof(xa, nullptr) : -0.5f;
                float cy   = ya[0] ? std::strtof(ya, nullptr) : 0.0f;
                if (zoom < 0.1f) zoom = 0.1f;

                const int MAX_ITER = 120;
                const float scale = 100.0f * zoom;

                for (int y = 0; y < 240; y++) {
                    for (int x = 0; x < 320; x++) {
                        float cr = (x - 160) / scale + cx;
                        float ci = (y - 120) / scale + cy;
                        float zr = 0, zi = 0, zr2 = 0, zi2 = 0;
                        int it = 0;
                        while (zr2 + zi2 <= 4.0f && it < MAX_ITER) {
                            zi = 2*zr*zi + ci;
                            zr = zr2 - zi2 + cr;
                            zr2 = zr*zr;
                            zi2 = zi*zi;
                            it++;
                        }
                        int r, g, b;
                        if (it >= MAX_ITER) {
                            r = 0; g = 0; b = 0;              // внутри — чёрный
                        } else {
                            /* Smooth coloring: сглаживаем через log */
                            float m2 = zr2 + zi2;
                            float sm = (float)it - std::log2(0.5f * std::log(m2));
                            if (sm < 0) sm = 0;
                            float t = sm * 0.05f;             // частота
                            /* Классическая палитра: тёмно-синий -> голубой -> белый -> оранжевый */
                            float w = 0.5f + 0.5f * std::cos(6.28318f * t);
                            r = (int)((1.0f - w) * 31);
                            g = (int)(std::sin(6.28318f * t * 1.5f) * 0.5f * 63 + 32);
                            b = (int)(w * 31);
                            if (r < 0) r = 0; if (r > 31) r = 31;
                            if (g < 0) g = 0; if (g > 63) g = 63;
                            if (b < 0) b = 0; if (b > 31) b = 31;
                        }
                        uint16_t c = (uint16_t)((r << 11) | (g << 5) | b);
                        std::memcpy(emu.mem.data.data() + L.upbase + y*640 + x*2, &c, 2);
                    }
                }
                L.init_term(); L.last_hash = 0xFFFFFFFFu; L.render();
                std::fprintf(stderr, "LCD mandelbrot zoom=%.2f center=(%.3f,%.3f) frames=%llu\n",
                            (double)zoom, (double)cx, (double)cy,
                            (unsigned long long)L.renders);
                return false;
            }
            // ==================== Скриншот в PPM ====================
            if (std::strcmp(arg1, "screenshot") == 0) {
                const char* fname = arg2[0] ? arg2 : "lcd.ppm";
                FILE* f = std::fopen(fname, "wb");
                if (!f) { std::fprintf(stderr, "cannot open %s\n", fname); return false; }
                std::fprintf(f, "P6\n320 240\n255\n");
                for (int y = 0; y < 240; y++) {
                    for (int x = 0; x < 320; x++) {
                        uint16_t c;
                        std::memcpy(&c, emu.mem.data.data() + L.upbase + y*640 + x*2, 2);
                        uint8_t rgb[3] = {
                            (uint8_t)(((c >> 11) & 0x1F) * 255 / 31),
                            (uint8_t)(((c >> 5)  & 0x3F) * 255 / 63),
                            (uint8_t)(( c        & 0x1F) * 255 / 31)
                        };
                        std::fwrite(rgb, 1, 3, f);
                    }
                }
                std::fclose(f);
                std::fprintf(stderr, "LCD screenshot -> %s (320x240 PPM)\n", fname);
                return false;
            }
            // ==================== Game of Life ====================
            if (std::strcmp(arg1, "life") == 0) {
                int gens = arg2[0] ? std::atoi(arg2) : 50;
                if (gens < 1)   gens = 1;
                if (gens > 500) gens = 500;

                const int W = 80, H = 60;          // клетки
                const int SCALE = 4;                // 4x4 пикселя на клетку
                std::vector<uint8_t> cur(W*H), nxt(W*H);

                // Начальная конфигурация: 25% случайных
                uint32_t rng = 0xC0FFEE42u;
                for (int i = 0; i < W*H; i++) {
                    rng = rng * 1664525u + 1013904223u;
                    cur[i] = ((rng >> 20) & 0x3) == 0 ? 1 : 0;
                }

                L.init_term();

                auto draw_field = [&](void) {
                    for (int y = 0; y < 240; y++) {
                        int cy = y / SCALE;
                        uint8_t* row = emu.mem.data.data() + L.upbase + y*640;
                        for (int x = 0; x < 320; x++) {
                            int cx = x / SCALE;
                            uint16_t c = cur[cy*W + cx] ? 0xFFFF : 0x0000;
                            std::memcpy(row + x*2, &c, 2);
                        }
                    }
                };

                for (int g = 0; g < gens; g++) {
                    // Отрисовать текущее поколение
                    draw_field();
                    L.last_hash = 0xFFFFFFFFu;
                    L.render();

                    // Посчитать следующее
                    for (int y = 0; y < H; y++) {
                        for (int x = 0; x < W; x++) {
                            int n = 0;
                            for (int dy = -1; dy <= 1; dy++) {
                                for (int dx = -1; dx <= 1; dx++) {
                                    if (dx == 0 && dy == 0) continue;
                                    int nx = (x + dx + W) % W;
                                    int ny = (y + dy + H) % H;
                                    n += cur[ny*W + nx];
                                }
                            }
                            int alive = cur[y*W + x];
                            nxt[y*W + x] =
                                (alive ? (n == 2 || n == 3) : (n == 3)) ? 1 : 0;
                        }
                    }
                    std::swap(cur, nxt);
                }

                // Финальный кадр
                draw_field();
                L.last_hash = 0xFFFFFFFFu;
                L.render();
                std::fprintf(stderr, "LCD life: %d generations on %dx%d grid (%llu frames)\n",
                            gens, W, H, (unsigned long long)L.renders);
                return false;
            }

            std::fprintf(stderr, "lcd dump|mode [..]|on|off|render|fb <a>|fill <c>|pixel <x> <y> <c>|gradient|checker|bars|plasma [t]|anim [n]|mandel [zoom] [cx] [cy]|life [gens]|screenshot <file>\n");
            return false;
        }
        if (std::strcmp(cmd, "uart0") == 0) {
            const char* p = line_str.c_str() + 5;
            while (*p == ' ') p++;
            for (const char* q = p; *q; ++q) emu.uart0.feed((uint8_t)*q);
            emu.uart0.feed(0x0D);
            std::printf("[UART0] отправлено %zu байт + CR\n", std::strlen(p));
            return false;
        }
        if (std::strcmp(cmd, "pl011") == 0) {
            emu.uart0.dump(); emu.uart1.dump(); emu.uart2.dump();
            return false;
        }
        if (std::strcmp(cmd, "sp804") == 0) {
            emu.timer0.dump(); emu.timer1.dump();
            return false;
        }
        if (std::strcmp(cmd, "pl061") == 0) {
            emu.gpio0.dump(); emu.gpio1.dump();
            return false;
        }
        if (std::strcmp(cmd, "vic") == 0) {
            emu.vic.dump();
            return false;
        }
        if (std::strcmp(cmd, "gpio") == 0) {
            if (std::strcmp(arg1, "set") == 0) {
                char idx[16]={0}, bits[16]={0};
                std::sscanf(line_str.c_str(), "%*s %*s %15s %15s", idx, bits);
                if (!idx[0] || !bits[0]) {
                    std::printf("Использование: gpio set <0|1> <bits>\n");
                    return false;
                }
                int which = std::atoi(idx);
                uint32_t v = parse_u32(bits);
                if (which == 0) emu.gpio0.set_input(v);
                else if (which == 1) emu.gpio1.set_input(v);
                else { std::printf("Только 0 или 1\n"); return false; }
                std::printf("GPIO%d <- 0x%02X\n", which, v);
                return false;
            }
            std::printf("Использование: gpio set <0|1> <bits>\n");
            return false;
        }

        // --- Config ---
        if (std::strcmp(cmd, "showcfg") == 0) { emu.showConfig(); return false; }
        if (std::strcmp(cmd, "savecfg") == 0) {
            std::string p = arg1[0] ? std::string(arg1) : std::string(cfg_path);
            emu.saveConfig(p);
            return false;
        }
        if (std::strcmp(cmd, "loadcfg") == 0) {
            const char* p = arg1[0] ? arg1 : cfg_path;
            if (emu.loadConfig(p)) {
                std::printf("[CFG] Загружено: %s\n", p);
                emu.applyConfig(false);
                emu.showConfig();
            } else std::printf("[CFG] Не удалось открыть: %s\n", p);
            return false;
        }
        if (std::strcmp(cmd, "wipe") == 0) { emu.wipeConfig(); return false; }

        if (std::strcmp(cmd, "set") == 0) {
            if (!arg1[0] || !arg2[0]) { std::printf("Использование: set <key> <value>\n"); return false; }
            std::string k = arg1;
            if      (k == "bin")      emu.config.bin_path  = arg2;
            else if (k == "addr")     emu.config.load_addr = parse_u32(arg2);
            else if (k == "entry")    emu.config.entry     = parse_u32(arg2);
            else if (k == "trap_lo")  emu.config.trap_lo   = parse_u32(arg2);
            else if (k == "trap_hi")  emu.config.trap_hi   = parse_u32(arg2);
            else if (k == "sp")       emu.config.sp        = parse_u32(arg2);
            else if (k == "history")  emu.config.history   = (std::atoi(arg2) != 0);
            else if (k == "strict")   emu.config.strict    = (std::atoi(arg2) != 0);
            else if (k == "autoload") emu.config.autoload  = (std::atoi(arg2) != 0);
            else { std::printf("Неизвестный ключ: %s\n", k.c_str()); return false; }
            emu.pc_trap_lo = emu.config.trap_lo;
            emu.pc_trap_hi = emu.config.trap_hi;
            emu.history_enabled = emu.config.history;
            emu.mem.strict = emu.config.strict;
            std::printf("OK: %s = %s\n", arg1, arg2);
            return false;
        }
        if (std::strcmp(cmd, "history") == 0) {
            if (arg1[0]) emu.config.history = (std::atoi(arg1) != 0);
            emu.history_enabled = emu.config.history;
            std::printf("history = %d\n", emu.history_enabled ? 1 : 0);
            return false;
        }
        if (std::strcmp(cmd, "strict") == 0) {
            if (arg1[0]) emu.config.strict = (std::atoi(arg1) != 0);
            emu.mem.strict = emu.config.strict;
            std::printf("strict = %d\n", emu.mem.strict ? 1 : 0);
            return false;
        }
        if (std::strcmp(cmd, "autoload") == 0) {
            if (arg1[0]) emu.config.autoload = (std::atoi(arg1) != 0);
            std::printf("autoload = %d\n", emu.config.autoload ? 1 : 0);
            return false;
        }

        std::printf("Неизвестная команда: %s\n", cmd);
        return false;
    };

    command_handler = handle_command;

    char line[4096];
    while (true) {
        std::printf("arm4> "); std::fflush(stdout);
        if (!std::fgets(line, sizeof(line), stdin)) { std::printf("\n"); break; }
        size_t len = std::strlen(line);
        if (len > 0 && line[len-1] == '\n') line[len-1] = 0;
        if (handle_command(line)) break;
    }

    if (!no_config && (!emu.config.bin_path.empty() || cfg_loaded)) {
        std::printf("[CFG] Автосохранение в %s\n", cfg_path);
        emu.saveConfig(cfg_path);
    }
    return 0;
}