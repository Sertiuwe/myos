extern CPU* g_cpu_ptr;

// ============================================================
// PortManager
// ============================================================
struct Port {
    std::string name;
    uint32_t value = 0;
    uint8_t  width = 4;
    bool     read_only = false;
    bool     trace = false;
    uint64_t reads = 0;
    uint64_t writes = 0;
    std::function<uint32_t(uint32_t)> on_read;
    std::function<void(uint32_t)>     on_write;
};

class PortManager {
public:
    static constexpr int MAX_PORTS = (PORT_END - PORT_BASE + 1) / 4;
    Port ports[MAX_PORTS];
    bool enabled = true;

    PortManager() { install_defaults(); }

    void install_defaults() {
        add_at(0x00, "UART_TX",     4, false);
        add_at(0x04, "UART_RX",     4, false);
        add_at(0x08, "UART_STATUS", 4, true);
        add_at(0x0C, "GPIO_OUT",    4, false);
        add_at(0x10, "GPIO_IN",     4, true);
        add_at(0x14, "TIMER_MS",    4, true);
        add_at(0x18, "HALT",        4, false);
        add_at(0x1C, "DEBUG_LOG",   4, false);

        int tx = find_by_name("UART_TX");
        if (tx >= 0) {
            ports[tx].on_write = [](uint32_t v) {
                char c = (char)(v & 0xFF);
                if (c == '\n' || (c >= 0x20 && c < 0x7F)) std::printf("%c", c);
                else std::printf("<%02X>", (unsigned)(v & 0xFF));
                std::fflush(stdout);
            };
        }
        int rx = find_by_name("UART_RX");
        if (rx >= 0) {
            ports[rx].on_read = [this, rx](uint32_t v) {
                uint32_t result = v;
                ports[rx].value = 0;
                return result;
            };
        }
        int st = find_by_name("UART_STATUS");
        if (st >= 0) {
            ports[st].on_read = [this](uint32_t) -> uint32_t {
                int rx_i = find_by_name("UART_RX");
                return (rx_i >= 0 && ports[rx_i].value != 0) ? 1u : 0u;
            };
        }
        int tm = find_by_name("TIMER_MS");
        if (tm >= 0) {
            ports[tm].on_read = [](uint32_t) -> uint32_t {
                if (g_cpu_ptr) return (uint32_t)(g_cpu_ptr->cycles / 16780);
                return 0;
            };
        }
        int halt = find_by_name("HALT");
        if (halt >= 0) {
            ports[halt].on_write = [](uint32_t) {
                if (g_cpu_ptr) g_cpu_ptr->halted = true;
            };
        }
        int dbg = find_by_name("DEBUG_LOG");
        if (dbg >= 0) {
            ports[dbg].on_write = [](uint32_t v) {
                std::printf("[DEBUG] 0x%08X\n", v);
            };
        }
    }

    static bool is_port(uint32_t a) {
        return a >= PORT_BASE && a <= PORT_END;
    }

    int find_by_addr(uint32_t addr) const {
        if (!is_port(addr)) return -1;
        uint32_t off = addr - PORT_BASE;
        int idx = (int)(off / 4);
        if (idx < 0 || idx >= MAX_PORTS) return -1;
        if (ports[idx].name.empty()) return -1;
        return idx;
    }
    int find_by_name(const std::string& n) const {
        for (int i = 0; i < MAX_PORTS; i++)
            if (ports[i].name == n) return i;
        return -1;
    }

    void add_at(uint32_t off, const char* name, uint8_t width, bool ro) {
        int idx = (int)(off / 4);
        if (idx < 0 || idx >= MAX_PORTS) return;
        ports[idx].name = name;
        ports[idx].width = width;
        ports[idx].read_only = ro;
    }

    bool add_port_by_addr(uint32_t addr, const char* name, uint8_t width = 4, bool ro = false) {
        if (!is_port(addr)) {
            std::printf("[PORT] адрес 0x%08X вне диапазона [0x%08X..0x%08X]\n",
                        addr, PORT_BASE, PORT_END);
            return false;
        }
        add_at(addr - PORT_BASE, name, width, ro);
        return true;
    }

    bool remove_by_name(const std::string& n) {
        int idx = find_by_name(n);
        if (idx < 0) return false;
        ports[idx] = Port();
        return true;
    }

    uint32_t read(uint32_t addr, uint8_t width) {
        int idx = find_by_addr(addr);
        if (idx < 0) return 0;
        Port& p = ports[idx];
        p.reads++;
        uint32_t v = p.value;
        if (p.on_read) v = p.on_read(v);
        uint32_t off = (addr & 3);
        uint32_t result = v;
        if (width == 1) result = (v >> (off * 8)) & 0xFF;
        else if (width == 2) result = (v >> (off * 8)) & 0xFFFF;
        if (p.trace)
            std::printf("[PORT] %s <- READ 0x%X\n", p.name.c_str(), result);
        return result;
    }

    void write(uint32_t addr, uint32_t value, uint8_t width) {
        int idx = find_by_addr(addr);
        if (idx < 0) return;
        Port& p = ports[idx];
        if (p.read_only) {
            if (p.trace)
                std::printf("[PORT] %s WRITE IGNORED (RO): 0x%X\n", p.name.c_str(), value);
            return;
        }
        p.writes++;
        uint32_t off = (addr & 3);
        uint32_t mask = 0xFFFFFFFFu, merged = value;
        if (width == 1)      { mask = 0xFFu << (off*8);   merged = (p.value & ~mask) | ((value & 0xFF)   << (off*8)); }
        else if (width == 2) { mask = 0xFFFFu << (off*8); merged = (p.value & ~mask) | ((value & 0xFFFF) << (off*8)); }
        p.value = merged;
        if (p.on_write) p.on_write(p.value);
        if (p.trace)
            std::printf("[PORT] %s <- WRITE 0x%X\n", p.name.c_str(), value);
    }

    void external_write(const std::string& name, uint32_t v) {
        int idx = find_by_name(name);
        if (idx < 0) { std::printf("[PORT] нет порта '%s'\n", name.c_str()); return; }
        ports[idx].value = v;
        std::printf("[PORT] %s = 0x%X\n", name.c_str(), v);
    }
    uint32_t external_read(const std::string& name) {
        int idx = find_by_name(name);
        if (idx < 0) { std::printf("[PORT] нет порта '%s'\n", name.c_str()); return 0; }
        return ports[idx].value;
    }

    void uart_send(const std::string& text) {
        int rx = find_by_name("UART_RX");
        if (rx < 0) { std::printf("[PORT] UART_RX не найден\n"); return; }
        for (char c : text) ports[rx].value = (uint32_t)(uint8_t)c;
        if (!text.empty()) ports[rx].value = (uint32_t)(uint8_t)text.back();
        std::printf("[PORT] отправлено '%s' (%zu байт)\n", text.c_str(), text.size());
    }

    void list() {
        std::printf("--- Порты (база 0x%08X, %d slots) ---\n", PORT_BASE, MAX_PORTS);
        bool any = false;
        for (int i = 0; i < MAX_PORTS; i++) {
            if (ports[i].name.empty()) continue;
            any = true;
            uint32_t addr = PORT_BASE + i * 4;
            std::printf("  [0x%08X] %-12s = 0x%08X  w=%d %s  r=%llu w=%llu%s\n",
                addr, ports[i].name.c_str(), ports[i].value,
                ports[i].width, ports[i].read_only ? "RO" : "RW",
                (unsigned long long)ports[i].reads,
                (unsigned long long)ports[i].writes,
                ports[i].trace ? " [trace]" : "");
        }
        if (!any) std::printf("  (пусто)\n");
    }
};

// ============================================================
// PL011 UART — ARM PrimeCell
// ============================================================
class PL011_UART {
public:
    uint32_t base;
    std::string name;
    uint32_t dr       = 0;
    uint32_t rsr      = 0;
    uint32_t fr       = 0x90;
    uint32_t ibrd     = 0;
    uint32_t fbrd     = 0;
    uint32_t lcr_h    = 0;
    uint32_t cr       = 0;
    uint32_t ifls     = 0;
    uint32_t imsc     = 0;
    uint32_t ris      = 0;
    uint32_t mis      = 0;
    uint32_t icr      = 0;
    uint32_t dmacr    = 0;
    uint32_t periph_id[4] = {0x11, 0x10, 0x14, 0x00};
    uint32_t pcell_id[4]  = {0x0D, 0xF0, 0x05, 0xB1};

    bool rx_ready = false;
    uint8_t rx_byte = 0;

    /* RX FIFO 256 байт */
    static constexpr int RX_FIFO_SIZE = 256;
    char rx_fifo[RX_FIFO_SIZE];
    int  rx_head = 0;
    int  rx_tail = 0;

    PL011_UART(uint32_t b, const char* n) : base(b), name(n) {}

    bool contains(uint32_t addr) const { return addr >= base && addr < base + 0x1000; }

    uint32_t read(uint32_t addr, int width) {
        uint32_t off = addr - base;
        uint32_t v = 0;
        switch (off & ~3u) {
            case 0x00:
                if (rx_head != rx_tail) {
                    v = (uint8_t)rx_fifo[rx_tail];
                    rx_tail = (rx_tail + 1) % RX_FIFO_SIZE;
                } else {
                    v = 0;
                }
                if (rx_head == rx_tail) { rx_ready = false; fr |= 0x10; }
                break;
            case 0x04: v = rsr; break;
            case 0x18: v = fr; break;
            case 0x24: v = ibrd; break;
            case 0x28: v = fbrd; break;
            case 0x2C: v = lcr_h; break;
            case 0x30: v = cr; break;
            case 0x34: v = ifls; break;
            case 0x38: v = imsc; break;
            case 0x3C: v = ris; break;
            case 0x40: v = mis; break;
            case 0x44: v = icr; break;
            case 0x48: v = dmacr; break;
            case 0xFE0: v = periph_id[0]; break;
            case 0xFE4: v = periph_id[1]; break;
            case 0xFE8: v = periph_id[2]; break;
            case 0xFEC: v = periph_id[3]; break;
            case 0xFF0: v = pcell_id[0]; break;
            case 0xFF4: v = pcell_id[1]; break;
            case 0xFF8: v = pcell_id[2]; break;
            case 0xFFC: v = pcell_id[3]; break;
            default: v = 0;
        }
        if (width == 2) v = (v >> ((addr & 2) * 8)) & 0xFFFF;
        else if (width == 1) v = (v >> ((addr & 3) * 8)) & 0xFF;
        return v;
    }

    void write(uint32_t addr, uint32_t v, int width) {
        (void)width;
        uint32_t off = addr - base;
        switch (off & ~3u) {
            case 0x00:
                if (cr & 0x01) {
                    char c = (char)(v & 0xFF);
                    std::printf("%c", c);
                    std::fflush(stdout);
                }
                break;
            case 0x24: ibrd = v & 0xFFFF; break;
            case 0x28: fbrd = v & 0x3F; break;
            case 0x2C: lcr_h = v & 0xFF; break;
            case 0x30: cr = v & 0xFFFF; break;
            case 0x34: ifls = v & 0x3F; break;
            case 0x38: imsc = v & 0x7FF; break;
            case 0x44:
                icr = v;
                {
                    uint32_t masked = v;
                    /* RX bit (0x10): не гасим, если в FIFO ещё есть байты */
                    if ((v & 0x10) && (rx_head != rx_tail)) {
                        masked &= ~0x10u;
                    }
                    ris &= ~masked;
                }
                mis = ris & imsc;
                break;
            case 0x48: dmacr = v & 0x7; break;
        }
    }

    void feed(uint8_t b) {
        int next = (rx_head + 1) % RX_FIFO_SIZE;
        if (next != rx_tail) {
            rx_fifo[rx_head] = (char)b;
            rx_head = next;
            rx_ready = true;
            fr &= ~0x10;
            ris |= 0x10;
            mis = ris & imsc;
        }
    }

    bool irq_pending() const { return (mis & imsc) != 0; }
    void tick() {}

    void dump() const {
        std::printf("--- PL011 UART @ 0x%08X (%s) ---\n", base, name.c_str());
        std::printf("  DR=0x%02X  FR=0x%02X  IBRD=%u  FBRD=%u  LCR_H=0x%02X  CR=0x%04X\n",
                    dr, fr, ibrd, fbrd, lcr_h, cr);
        std::printf("  IMSC=0x%03X  RIS=0x%03X  MIS=0x%03X  rx_ready=%d\n",
                    imsc, ris, mis, (int)rx_ready);
    }
};

// ============================================================
// SP804 Dual Timer — ARM PrimeCell
// ============================================================
class SP804_Timer {
public:
    uint32_t base;
    std::string name;
    struct Timer {
        uint32_t load = 0;
        uint32_t value = 0;
        uint32_t control = 0;
        uint32_t bg_load = 0;
        uint32_t ris = 0;
        uint32_t mis = 0;
        bool     enabled = false;
        bool     oneshot = false;
        uint32_t prescale = 1;
        uint32_t div = 0;
    } t[2];
    uint32_t periph_id[4] = {0x04, 0x18, 0x14, 0x00};
    uint32_t pcell_id[4]  = {0x0D, 0xF0, 0x05, 0xB1};

    SP804_Timer(uint32_t b, const char* n) : base(b), name(n) {}

    bool contains(uint32_t addr) const { return addr >= base && addr < base + 0x1000; }

    uint32_t read(uint32_t addr, int width) {
        uint32_t off = addr - base;
        uint32_t v = 0;
        switch (off & ~3u) {
            case 0x00: v = t[0].load; break;
            case 0x04: v = t[0].value; break;
            case 0x08: v = t[0].control; break;
            case 0x0C: v = t[0].ris; break;
            case 0x10: v = t[0].mis; break;
            case 0x14: v = t[0].bg_load; break;
            case 0x20: v = t[1].load; break;
            case 0x24: v = t[1].value; break;
            case 0x28: v = t[1].control; break;
            case 0x2C: v = t[1].ris; break;
            case 0x30: v = t[1].mis; break;
            case 0x34: v = t[1].bg_load; break;
            case 0xFE0: v = periph_id[0]; break;
            case 0xFE4: v = periph_id[1]; break;
            case 0xFE8: v = periph_id[2]; break;
            case 0xFEC: v = periph_id[3]; break;
            case 0xFF0: v = pcell_id[0]; break;
            case 0xFF4: v = pcell_id[1]; break;
            case 0xFF8: v = pcell_id[2]; break;
            case 0xFFC: v = pcell_id[3]; break;
            default: v = 0;
        }
        if (width == 2) v = (v >> ((addr & 2) * 8)) & 0xFFFF;
        else if (width == 1) v = (v >> ((addr & 3) * 8)) & 0xFF;
        return v;
    }

    void write(uint32_t addr, uint32_t v, int width) {
        (void)width;
        uint32_t off = addr - base;
        switch (off & ~3u) {
            case 0x00: t[0].load = v; t[0].value = v; break;
            case 0x04: break;
            case 0x08:
                t[0].control = v & 0xFF;
                t[0].enabled = (v & 0x80) != 0;
                { bool periodic = (v & 0x40) != 0;
                  bool oshot    = (v & 0x01) != 0;
                  t[0].oneshot  = oshot || !periodic; }
                t[0].prescale = ((v >> 2) & 0xF) + 1;
                if (t[0].enabled && t[0].value == 0) t[0].value = t[0].load;
                if (!t[0].enabled) t[0].value = t[0].load;
                break;
            case 0x0C: t[0].ris &= ~v; t[0].mis = t[0].ris & ((t[0].control & 0x20) ? 0xFFFFFFFF : 0); break;
            case 0x10: break;
            case 0x14: t[0].bg_load = v; break;
            case 0x20: t[1].load = v; t[1].value = v; break;
            case 0x24: break;
            case 0x28:
                t[1].control = v & 0xFF;
                t[1].enabled = (v & 0x80) != 0;
                { bool periodic = (v & 0x40) != 0;
                  bool oshot    = (v & 0x01) != 0;
                  t[1].oneshot  = oshot || !periodic; }
                t[1].prescale = ((v >> 2) & 0xF) + 1;
                if (t[1].enabled && t[1].value == 0) t[1].value = t[1].load;
                if (!t[1].enabled) t[1].value = t[1].load;
                break;
            case 0x2C: t[1].ris &= ~v; t[1].mis = t[1].ris & ((t[1].control & 0x20) ? 0xFFFFFFFF : 0); break;
            case 0x30: break;
            case 0x34: t[1].bg_load = v; break;
        }
    }

    void tick() {
        for (int i = 0; i < 2; i++) {
            if (!t[i].enabled) continue;
            t[i].div++;
            if (t[i].div < t[i].prescale) continue;
            t[i].div = 0;
            if (t[i].value > 0) t[i].value--;
            if (t[i].value == 0) {
                t[i].ris |= 1;
                t[i].mis = t[i].ris & ((t[i].control & 0x20) ? 0xFFFFFFFF : 0);
                if (!t[i].oneshot) t[i].value = t[i].load;
                else t[i].enabled = false;
            }
        }
    }

    bool irq_pending() const {
        return (t[0].mis & 1) || (t[1].mis & 1);
    }

    void dump() const {
        std::printf("--- SP804 Timer @ 0x%08X (%s) ---\n", base, name.c_str());
        for (int i = 0; i < 2; i++) {
            std::printf("  Timer%d: load=%u value=%u ctrl=0x%02X %s ris=%u mis=%u prescale=%u\n",
                        i, t[i].load, t[i].value, t[i].control,
                        t[i].enabled ? "ON" : "OFF", t[i].ris, t[i].mis, t[i].prescale);
        }
    }
};

// ============================================================
// PL061 GPIO — ARM PrimeCell
// ============================================================
class PL061_GPIO {
public:
    uint32_t base;
    std::string name;
    uint32_t data = 0;
    uint32_t dir = 0;
    uint32_t is = 0;
    uint32_t ibe = 0;
    uint32_t iev = 0;
    uint32_t ie = 0;
    uint32_t ris = 0;
    uint32_t mis = 0;
    uint32_t ic = 0;
    uint32_t periph_id[4] = {0x61, 0x10, 0x14, 0x00};
    uint32_t pcell_id[4]  = {0x0D, 0xF0, 0x05, 0xB1};

    PL061_GPIO(uint32_t b, const char* n) : base(b), name(n) {}

    bool contains(uint32_t addr) const { return addr >= base && addr < base + 0x1000; }

    uint32_t read(uint32_t addr, int width) {
        uint32_t off = addr - base;
        uint32_t v = 0;
        switch (off & ~3u) {
            case 0x000: v = data; break;
            case 0x400: v = dir; break;
            case 0x404: v = is; break;
            case 0x408: v = ibe; break;
            case 0x40C: v = iev; break;
            case 0x410: v = ie; break;
            case 0x414: v = ris; break;
            case 0x418: v = mis; break;
            case 0x41C: v = ic; break;
            case 0xFE0: v = periph_id[0]; break;
            case 0xFE4: v = periph_id[1]; break;
            case 0xFE8: v = periph_id[2]; break;
            case 0xFEC: v = periph_id[3]; break;
            case 0xFF0: v = pcell_id[0]; break;
            case 0xFF4: v = pcell_id[1]; break;
            case 0xFF8: v = pcell_id[2]; break;
            case 0xFFC: v = pcell_id[3]; break;
            default: v = 0;
        }
        if (width == 2) v = (v >> ((addr & 2) * 8)) & 0xFFFF;
        else if (width == 1) v = (v >> ((addr & 3) * 8)) & 0xFF;
        return v;
    }

    void write(uint32_t addr, uint32_t v, int width) {
        (void)width;
        uint32_t off = addr - base;
        switch (off & ~3u) {
            case 0x000: data = v & 0xFF; break;
            case 0x400: dir = v & 0xFF; break;
            case 0x404: is = v & 0xFF; break;
            case 0x408: ibe = v & 0xFF; break;
            case 0x40C: iev = v & 0xFF; break;
            case 0x410: ie = v & 0xFF; break;
            case 0x41C: ic = v & 0xFF; ris &= ~v; mis = ris & ie; break;
        }
    }

    void set_input(uint32_t bits) {
        uint32_t old = data;
        data = (data & dir) | (bits & ~dir);
        uint32_t diff = (data ^ old) & ~dir;
        if (diff) {
            uint32_t active;
            if (iev == 0) active = diff & ~data;
            else          active = diff & data;
            if (ibe == 0xFF) active = diff;
            ris |= active;
            mis = ris & ie;
        }
    }

    bool irq_pending() const { return (mis & ie) != 0; }
    void tick() {}

    void dump() const {
        std::printf("--- PL061 GPIO @ 0x%08X (%s) ---\n", base, name.c_str());
        std::printf("  DATA=0x%02X  DIR=0x%02X  IE=0x%02X  RIS=0x%02X  MIS=0x%02X\n",
                    data, dir, ie, ris, mis);
    }
};

// ============================================================
// PL190 VIC — Vectored Interrupt Controller
// ============================================================
class PL190_VIC {
public:
    uint32_t base;
    std::string name;

    uint32_t irq_status = 0;
    uint32_t fiq_status = 0;
    uint32_t raw_intr   = 0;
    uint32_t int_select = 0;
    uint32_t int_enable = 0;
    uint32_t soft_int   = 0;
    uint32_t protect    = 0;
    uint32_t vect_addr  = 0;
    uint32_t def_vect_addr = 0;

    uint32_t vect_addr_reg[16] = {0};
    uint32_t vect_cntl_reg[16] = {0};

    uint32_t periph_id[4] = {0x90, 0x11, 0x04, 0x00};
    uint32_t pcell_id[4]  = {0x0D, 0xF0, 0x05, 0xB1};

    PL190_VIC(uint32_t b, const char* n) : base(b), name(n) {}

    bool contains(uint32_t addr) const { return addr >= base && addr < base + 0x1000; }

    uint32_t read(uint32_t addr, int width) {
        uint32_t off = addr - base;
        uint32_t v = 0;
        if (off >= 0x100 && off < 0x140) {
            v = vect_addr_reg[(off - 0x100) / 4];
        } else if (off >= 0x200 && off < 0x240) {
            v = vect_cntl_reg[(off - 0x200) / 4];
        } else {
            switch (off & ~3u) {
                case 0x00: v = irq_status; break;
                case 0x04: v = fiq_status; break;
                case 0x08: v = raw_intr; break;
                case 0x0C: v = int_select; break;
                case 0x10: v = int_enable; break;
                case 0x14: v = 0; break;
                case 0x18: v = soft_int; break;
                case 0x1C: v = 0; break;
                case 0x20: v = protect; break;
                case 0x30: v = vect_addr; break;
                case 0x34: v = def_vect_addr; break;
                case 0xFE0: v = periph_id[0]; break;
                case 0xFE4: v = periph_id[1]; break;
                case 0xFE8: v = periph_id[2]; break;
                case 0xFEC: v = periph_id[3]; break;
                case 0xFF0: v = pcell_id[0]; break;
                case 0xFF4: v = pcell_id[1]; break;
                case 0xFF8: v = pcell_id[2]; break;
                case 0xFFC: v = pcell_id[3]; break;
                default: v = 0;
            }
        }
        if (width == 2) v = (v >> ((addr & 2) * 8)) & 0xFFFF;
        else if (width == 1) v = (v >> ((addr & 3) * 8)) & 0xFF;
        return v;
    }

    void write(uint32_t addr, uint32_t v, int width) {
        (void)width;
        uint32_t off = addr - base;
        if (off >= 0x100 && off < 0x140) {
            vect_addr_reg[(off - 0x100) / 4] = v;
        } else if (off >= 0x200 && off < 0x240) {
            vect_cntl_reg[(off - 0x200) / 4] = v;
        } else {
            switch (off & ~3u) {
                case 0x0C: int_select = v; break;
                case 0x10: int_enable |= v; break;
                case 0x14: int_enable &= ~v; break;
                case 0x18: soft_int |= v; break;
                case 0x1C: soft_int &= ~v; break;
                case 0x20: protect = v; break;
                case 0x30: vect_addr = v; break;
                case 0x34: def_vect_addr = v; break;
            }
        }
        update_status();
    }

    void set_source(int irq_num, bool active) {
        if (irq_num < 0 || irq_num > 31) return;
        if (active) raw_intr |= (1u << irq_num);
        else        raw_intr &= ~(1u << irq_num);
        update_status();
    }

    void update_status() {
        uint32_t active = raw_intr | soft_int;
        irq_status = active & int_enable & ~int_select;
        fiq_status = active & int_enable & int_select;

        vect_addr = def_vect_addr;
        for (int i = 0; i < 16; i++) {
            uint32_t ctrl = vect_cntl_reg[i];
            if (ctrl & 0x20) {
                int src = ctrl & 0x1F;
                if (irq_status & (1u << src)) {
                    vect_addr = vect_addr_reg[i];
                    break;
                }
            }
        }
    }

    bool irq_pending() const { return irq_status != 0; }
    bool fiq_pending() const { return fiq_status != 0; }

    void dump() const {
        std::printf("--- PL190 VIC @ 0x%08X (%s) ---\n", base, name.c_str());
        std::printf("  IRQStatus=0x%08X  FIQStatus=0x%08X  RawIntr=0x%08X\n",
                    irq_status, fiq_status, raw_intr);
        std::printf("  IntEnable=0x%08X  IntSelect=0x%08X  SoftInt=0x%08X\n",
                    int_enable, int_select, soft_int);
        std::printf("  VectAddr=0x%08X  DefVectAddr=0x%08X\n", vect_addr, def_vect_addr);
        for (int i = 0; i < 16; i++) {
            if (vect_cntl_reg[i] & 0x20) {
                std::printf("  Vect[%d]: addr=0x%08X cntl=0x%02X (src=%d)\n",
                            i, vect_addr_reg[i], vect_cntl_reg[i], vect_cntl_reg[i] & 0x1F);
            }
        }
    }
};

