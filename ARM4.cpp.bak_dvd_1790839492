static std::string trim(const std::string& s) {
    size_t a = 0, b = s.size();
    while (a < b && std::isspace((unsigned char)s[a])) a++;
    while (b > a && std::isspace((unsigned char)s[b-1])) b--;
    return s.substr(a, b - a);
}
static uint32_t parse_u32(const char* s) {
    if (!s) return 0;
    return (uint32_t)std::strtoul(s, nullptr, 0);
}
static bool has_ext(const std::string& s, const char* ext) {
    size_t n = std::strlen(ext), p = s.size();
    if (p < n) return false;
    for (size_t i = 0; i < n; i++)
        if (std::tolower((unsigned char)s[p-n+i]) != std::tolower((unsigned char)ext[i]))
            return false;
    return true;
}
static bool looks_like_binary(const std::string& s) {
    return has_ext(s, ".bin") || has_ext(s, ".rom") || has_ext(s, ".gba") ||
           has_ext(s, ".img") || has_ext(s, ".fw")  || has_ext(s, ".hex");
}

// ============================================================
// ROMLO
// ============================================================
class RomLoader {
public:
    static bool loadBinary(Memory& mem, const char* filename, uint32_t addr, size_t* out_size = nullptr) {
        FILE* f = std::fopen(filename, "rb");
        if (!f) { std::printf("[ROMLO] Не могу открыть: %s\n", filename); return false; }
        std::fseek(f, 0, SEEK_END);
        long size = std::ftell(f);
        std::fseek(f, 0, SEEK_SET);
        if (size <= 0) { std::printf("[ROMLO] Файл пуст\n"); std::fclose(f); return false; }
        std::vector<uint8_t> buf(size);
        size_t got = std::fread(buf.data(), 1, size, f);
        std::fclose(f);
        if ((long)got != size) { std::printf("[ROMLO] Ошибка чтения\n"); return false; }
        mem.load(buf.data(), size, addr);
        if (out_size) *out_size = (size_t)size;
        std::printf("[ROMLO] Загружено %ld байт по адресу 0x%08X\n", size, addr);
        if (size >= 2 && buf[0] == '#' && buf[1] == ' ')
            std::printf("[ROMLO] ПРЕДУПРЕЖДЕНИЕ: файл начинается с '# ' — похоже это конфиг!\n");
        return true;
    }
    static void printInfo(Memory& mem, uint32_t addr) {
        uint32_t w0 = mem.read32(addr);
        uint32_t w1 = mem.read32(addr + 4);
        std::printf("[ROMLO] Вектор 0: 0x%08X\n", w0);
        std::printf("[ROMLO] Вектор 1: 0x%08X\n", w1);
    }
    static void setupCPU(CPU& cpu, uint32_t entry, uint32_t sp) {
        cpu.r[15] = entry;
        cpu.cpsr.raw = 0;
        cpu.cpsr.set_mode(Mode::Supervisor);
        cpu.cpsr.set_i(true);
        cpu.cpsr.set_f(true);
        cpu.cpsr.set_t(false);
        cpu.banks[3].r13 = sp;
        cpu.banks[3].r14 = 0;
    }
};

