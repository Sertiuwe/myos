        uint32_t a = addr + i * 4;
        uint32_t v = emu.mem.read32(a);
        std::printf("  [0x%08X] = 0x%08X\n", a, v);
    }
    std::printf("\n");
}

// ============================================================
// Тесты
// ============================================================
static int run_tests() {
    std::printf("=== Тесты v17 ===\n\n");

    // VIC базовый — VectAddrReg + VectCntl + IntEnable + SoftInt
    {
        Emulator emu;
        uint32_t prog[] = {
            0xE59F001C,  // 0x00 LDR r0, [pc, #28]  ; r0 = 0x10140000
            0xE59F101C,  // 0x04 LDR r1, [pc, #28]  ; r1 = 0x00008000
            0xE5801100,  // 0x08 STR r1, [r0, #0x100]  ; VectAddrReg[0] = 0x8000
            0xE3A0102C,  // 0x0C MOV r1, #0x2C
            0xE5801200,  // 0x10 STR r1, [r0, #0x200]  ; VectCntl[0] = 0x20|12
            0xE3A01A01,  // 0x14 MOV r1, #0x1000
            0xE5801010,  // 0x18 STR r1, [r0, #0x10]   ; IntEnable = 0x1000
            0xE5801018,  // 0x1C STR r1, [r0, #0x18]   ; SoftInt  = 0x1000
            0xEAFFFFFE,  // 0x20 B .
            0x10140000,  // 0x24 data: VIC base
            0x00008000   // 0x28 data: vector
        };
        for (size_t i = 0; i < sizeof(prog)/4; i++) emu.mem.write32(i*4, prog[i]);
        emu.run(100, false);
        std::printf("VIC test: VectAddr=0x%08X (ожид. 0x8000)\n", emu.vic.vect_addr);
        std::printf("  IntEnable=0x%08X (ожид. 0x1000)\n", emu.vic.int_enable);
        std::printf("  VectCntl[0]=0x%02X  IRQStatus=0x%08X (ожид. 0x1000)\n\n",
                    emu.vic.vect_cntl_reg[0], emu.vic.irq_status);
    }

    // VIC — генерация от UART
    {
        Emulator emu;
        emu.vic.vect_addr_reg[0] = 0x8000;
        emu.vic.vect_cntl_reg[0] = 0x20 | 12;
        emu.vic.int_enable = (1u << 12);
        emu.uart0.feed('A');
        emu.vic.set_source(12, true);
        std::printf("VIC UART test: IRQStatus=0x%08X (ожид. 0x1000)\n",
                    emu.vic.irq_status);
        std::printf("  VectAddr=0x%08X (ожид. 0x8000)\n\n", emu.vic.vect_addr);
    }

    // PL011 вывод
    {
        Emulator emu;
        uint32_t prog[] = {
            0xE59F0008, 0xE3A01048, 0xE5801000, 0xEAFFFFFE, 0x10009000
        };
        for (size_t i = 0; i < sizeof(prog)/4; i++) emu.mem.write32(i*4, prog[i]);
        emu.uart0.cr = 1;
        std::printf("PL011 test: вывод -> \"");
        std::fflush(stdout);
        emu.run(100, false);
        std::printf("\"\n\n");
    }

    // === v19 regression tests ===

    // MMU: section translation fault (unmapped VA)
    {
        Emulator emu;
        uint32_t ttbr = 0x500000;
        emu.cp15.ttbr0 = ttbr;
        emu.cp15.dacr = 0x00000001;
        emu.cp15.sctlr |= 1;
        emu.mmu.flush();
        bool fault = false; int code = 0;
        uint32_t pa = emu.mmu.translate(0x00200000u, false, false, false,
                                        fault, code, emu.cp15);
        std::printf("MMU trans fault: fault=%d code=0x%X pa=0x%08X (ожид. 1/0x5/VA)\n",
                    (int)fault, code, pa);
    }

    // MMU: permission fault (priv-only section, user access)
    {
        Emulator emu;
        uint32_t ttbr = 0x500000;
        uint32_t desc = 0x00000412u;   // section, AP=01 (priv), dom=0
        std::memcpy(&emu.mem.data[ttbr], &desc, 4);
        emu.cp15.ttbr0 = ttbr;
        emu.cp15.dacr = 0x00000001;
        emu.cp15.sctlr |= 1;
        emu.mmu.flush();
        bool fault = false; int code = 0;
        emu.mmu.translate(0x00000100u, false, true, false,
                          fault, code, emu.cp15);
        std::printf("MMU perm fault: fault=%d code=0x%X DFSR=0x%X (ожид. 1/0xD)\n",
                    (int)fault, code, emu.cp15.dfsr);
    }

    // MMU: full access + TLB hit
    {
        Emulator emu;
        uint32_t ttbr = 0x500000;
        uint32_t desc = 0x00000C12u;   // section, AP=11 (full), dom=0
        std::memcpy(&emu.mem.data[ttbr], &desc, 4);
        emu.cp15.ttbr0 = ttbr;
        emu.cp15.dacr = 0x00000001;
        emu.cp15.sctlr |= 1;
        emu.mmu.flush();
        bool fault = false; int code = 0;
        uint32_t pa1 = emu.mmu.translate(0x00001234u, false, false, false,
                                         fault, code, emu.cp15);
        uint32_t pa2 = emu.mmu.translate(0x00005678u, false, false, false,
                                         fault, code, emu.cp15);
        std::printf("MMU map: pa1=0x%08X pa2=0x%08X hits=%llu misses=%llu (ожид. 1234/5678/1/1)\n",
                    pa1, pa2,
                    (unsigned long long)emu.mmu.tlb_hits,
                    (unsigned long long)emu.mmu.tlb_misses);
    }

    // Cache: miss then hit
    {
        Emulator emu;
        emu.mem.write32(0x1000, 0xDEADBEEFu);
        emu.mem.dcache.invalidate_all();
        emu.mem.dcache.reset_stats();
        uint32_t v1 = emu.mem.read32(0x1000);
        uint32_t v2 = emu.mem.read32(0x1000);
        std::printf("Cache: v1=0x%08X v2=0x%08X hits=%llu misses=%llu (ожид. DEADBEEF/DEADBEEF/1/1)\n",
                    v1, v2,
                    (unsigned long long)emu.mem.dcache.hits,
                    (unsigned long long)emu.mem.dcache.misses);
    }

    // Thumb: MOV r0,#10 ; ADD r0,#5 ; SUB r0,#3
    {
        Emulator emu;
        // прямая запись в backing buffer, минуя MMU и кеш
        emu.mem.data[0] = 0x0A; emu.mem.data[1] = 0x20;   // 0x200A
        emu.mem.data[2] = 0x05; emu.mem.data[3] = 0x30;   // 0x3005
        emu.mem.data[4] = 0x03; emu.mem.data[5] = 0x38;   // 0x3803
        emu.mem.icache.invalidate_all();
        emu.mem.dcache.invalidate_all();
        emu.cpu.cpsr.set_t(true);
        emu.cpu.r[15] = 0;
        emu.step(); emu.step(); emu.step();
        std::printf("Thumb: r0=0x%08X (ожид. 0xC)\n", emu.cpu.r[0]);
    }

    // FIQ: R8-R12 banking
    {
        Emulator emu;
        emu.cpu.cpsr.set_mode(Mode::User);
        emu.cpu.r[8] = 0xAAAAAAAAu;
        uint32_t before = emu.cpu.get_reg(8);
        emu.cpu.take_exception(0x1C, Mode::FIQ, false);
        emu.cpu.set_reg(8, 0xBBBBBBBBu);
        uint32_t in_fiq = emu.cpu.get_reg(8);
        emu.cpu.cpsr.set_mode(Mode::User);
        uint32_t after = emu.cpu.get_reg(8);
        std::printf("FIQ bank: before=0x%08X in_fiq=0x%08X after=0x%08X banked=0x%08X\n",
                    before, in_fiq, after, emu.cpu.banks[1].r8_12[0]);
        std::printf("  ожид.: AAAAAAAA BBBBBBBB AAAAAAAA BBBBBBBB\n");
    }

    // VMCU int
    {
        Emulator emu;
        uint32_t prog[] = {0x1000002A, 0x11000008, 0x43000000};
        for (int i = 0; i < 3; i++)
            for (int b = 0; b < 4; b++)
                emu.vmcu.mem[i*4+b] = (prog[i] >> (b*8)) & 0xFF;
        emu.vmcu.pc = 0; emu.vmcu.running = true; emu.vmcu.halted = false;
        for (int i = 0; i < 200 && !emu.vmcu.halted; i++) emu.vmcu.step();
        std::printf("VMCU test: r0=%u halted=%d cycles=%llu (ожид. 50, 1, 3)\n",
                    emu.vmcu.r[0], (int)emu.vmcu.halted,
                    (unsigned long long)emu.vmcu.cycles);
    }

    // VMCU FPU
    {
        Emulator emu;
        uint32_t prog[] = {0x5D000005, 0x5D100003, 0x50201000, 0x5A020000, 0x43000000};
        for (int i = 0; i < 5; i++)
            for (int b = 0; b < 4; b++)
                emu.vmcu.mem[i*4+b] = (prog[i] >> (b*8)) & 0xFF;
        emu.vmcu.pc = 0; emu.vmcu.running = true; emu.vmcu.halted = false;
        for (int i = 0; i < 200 && !emu.vmcu.halted; i++) emu.vmcu.step();
        std::printf("VMCU FPU: r0=%u F2=%.6g halted=%d (ожид. 8, 8, 1)\n",
                    emu.vmcu.r[0], (double)emu.vmcu.fp[2], (int)emu.vmcu.halted);
    }

    std::printf("=== Готово ===\n\n");
    return 0;
}

// ============================================================
// MAIN
// ============================================================
int main(int argc, char** argv) {
    Emulator emu;
    const char* cfg_path = DEFAULT_CFG;
    bool no_config = false;

    for (int i = 1; i < argc; i++) {
        if (std::strcmp(argv[i], "--test") == 0) return run_tests();
        if (std::strcmp(argv[i], "--config") == 0 && i + 1 < argc) { cfg_path = argv[++i]; continue; }
        if (std::strcmp(argv[i], "--no-config") == 0) { no_config = true; continue; }
        if (argv[i][0] == '-') { std::printf("Неизвестный параметр: %s\n", argv[i]); return 1; }
    }

    print_banner();

    bool cfg_loaded = false;
    if (!no_config) {
        if (emu.loadConfig(cfg_path)) {
            cfg_loaded = true;
            std::printf("[CFG] Загружен конфиг: %s\n", cfg_path);
            if (emu.config.autoload && !emu.config.bin_path.empty()) emu.applyConfig(true);
            else emu.applyConfig(false);
        } else {
            std::printf("[CFG] Конфиг не найден (%s)\n", cfg_path);
        }
    }

    if (argc >= 2 && argv[1][0] != '-') {
        const char* path = argv[1];
        uint32_t addr = (argc >= 3) ? parse_u32(argv[2]) : 0;
        emu.config.bin_path  = path;
        emu.config.load_addr = addr;
        emu.config.entry     = addr;
        emu.config.trap_lo   = addr;
        emu.config.trap_hi   = addr + 0x3FFF;
        emu.loadBin();
    }

    print_help();

    std::function<bool(const std::string&)> command_handler;

    auto handle_command = [&](const std::string& line_str) -> bool {
        char line[4096];
        std::strncpy(line, line_str.c_str(), sizeof(line) - 1);
        line[sizeof(line) - 1] = 0;

        char cmd[64] = {0}, arg1[512] = {0}, arg2[64] = {0};
        std::sscanf(line, "%63s %511s %63s", cmd, arg1, arg2);
        if (!cmd[0]) return false;

        if (std::strcmp(cmd, "exit") == 0 || std::strcmp(cmd, "quit") == 0) return true;
        if (std::strcmp(cmd, "help") == 0) { print_help(); return false; }
        if (std::strcmp(cmd, "test") == 0) { run_tests(); return false; }

        if (std::strcmp(cmd, "load") == 0 || std::strcmp(cmd, "loadbin") == 0) {
            if (!arg1[0]) { std::printf("Использование: %s <путь> [addr]\n", cmd); return false; }
            uint32_t addr = arg2[0] ? parse_u32(arg2) : 0;
            emu.config.bin_path  = arg1;
            emu.config.load_addr = addr;
            emu.config.entry     = addr;
            emu.config.trap_lo   = addr;
            emu.config.trap_hi   = addr + 0x3FFF;
            if (std::strcmp(cmd, "loadbin") == 0) emu.config.autoload = true;
            if (emu.loadBin())
                std::printf("OK. Trap: [0x%08X..0x%08X]\n", emu.pc_trap_lo, emu.pc_trap_hi);
            return false;
        }
