// ============================================================
// ARM64 asm helpers
// ============================================================
static inline uint32_t clz_asm(uint32_t x) {
#if defined(__aarch64__)
    uint32_t r; __asm__ volatile("clz %w0, %w1" : "=r"(r) : "r"(x)); return r;
#else
    if (x == 0) return 32; uint32_t n = 0;
    if (!(x & 0xFFFF0000)) { n += 16; x <<= 16; }
    if (!(x & 0xFF000000)) { n += 8;  x <<= 8;  }
    if (!(x & 0xF0000000)) { n += 4;  x <<= 4;  }
    if (!(x & 0xC0000000)) { n += 2;  x <<= 2;  }
    if (!(x & 0x80000000)) { n += 1; }
    return n;
#endif
}
static inline uint32_t ror_asm(uint32_t v, uint32_t n) {
#if defined(__aarch64__)
    uint32_t r; __asm__ volatile("ror %w0, %w1, %w2" : "=r"(r) : "r"(v), "r"(n & 31)); return r;
#else
    n &= 31; if (n == 0) return v; return (v >> n) | (v << (32 - n));
#endif
}
static inline void dmb_ish() {
#if defined(__aarch64__)
    __asm__ volatile("dmb ish" ::: "memory");
#endif
}
static inline uint64_t umul64(uint32_t a, uint32_t b) { return (uint64_t)a * (uint64_t)b; }
static inline int64_t  smul64(int32_t a, int32_t b)   { return (int64_t)a * (int64_t)b; }

// ============================================================
// Режимы / CPSR / Bank
// ============================================================
enum class Mode : uint8_t {
    User = 0x10, FIQ = 0x11, IRQ = 0x12,
    Supervisor = 0x13, Abort = 0x17,
    Undefined = 0x1B, System = 0x1F,
};
static inline int mode_index(Mode m) {
    switch (m) {
        case Mode::User:       return 0;
        case Mode::FIQ:        return 1;
        case Mode::IRQ:        return 2;
        case Mode::Supervisor: return 3;
        case Mode::Abort:      return 4;
        case Mode::Undefined:  return 5;
        case Mode::System:     return 6;
        default:               return 3;
    }
}
struct CPSR {
    uint32_t raw = 0;
    Mode mode() const { return static_cast<Mode>(raw & 0x1F); }
    void set_mode(Mode m) { raw = (raw & ~0x1Fu) | (uint32_t)m; }
    bool n() const { return (raw >> 31) & 1; }
    bool z() const { return (raw >> 30) & 1; }
    bool c() const { return (raw >> 29) & 1; }
    bool v() const { return (raw >> 28) & 1; }
    bool i() const { return (raw >> 7)  & 1; }
    bool f() const { return (raw >> 6)  & 1; }
    bool t() const { return (raw >> 5)  & 1; }
    void set_n(bool b) { raw = b ? (raw|(1u<<31)) : (raw&~(1u<<31)); }
    void set_z(bool b) { raw = b ? (raw|(1u<<30)) : (raw&~(1u<<30)); }
    void set_c(bool b) { raw = b ? (raw|(1u<<29)) : (raw&~(1u<<29)); }
    void set_v(bool b) { raw = b ? (raw|(1u<<28)) : (raw&~(1u<<28)); }
    void set_i(bool b) { raw = b ? (raw|(1u<<7))  : (raw&~(1u<<7)); }
    void set_f(bool b) { raw = b ? (raw|(1u<<6))  : (raw&~(1u<<6)); }
    void set_t(bool b) { raw = b ? (raw|(1u<<5))  : (raw&~(1u<<5)); }
};
struct Bank { uint32_t r8_12[5] = {0}; uint32_t r13 = 0; uint32_t r14 = 0; uint32_t spsr = 0; };

// ============================================================
// CPU
// ============================================================
class CPU {
public:
    uint32_t r[16] = {0};
    CPSR cpsr;
    Bank banks[7];
    bool halted = false;
    uint64_t cycles = 0;

    CPU() {
        cpsr.set_mode(Mode::Supervisor);
        cpsr.set_i(true);
        cpsr.set_f(true);
    }
    Mode mode() const { return cpsr.mode(); }
    int bank_idx() const { return mode_index(mode()); }

    uint32_t get_reg(int n) const {
        if (n == 15) return r[15];
        int idx = bank_idx();
        if (n >= 8 && n <= 12) {
            if (idx == 1) return banks[1].r8_12[n - 8];
            return r[n];
        }
        if (n == 13 || n == 14) {
            if (idx == 0 || idx == 6) return r[n];
            const Bank& b = banks[idx];
            return (n == 13) ? b.r13 : b.r14;
        }
        return r[n];
    }
    void set_reg(int n, uint32_t v) {
        if (n == 15) { r[15] = v; return; }
        int idx = bank_idx();
        if (n >= 8 && n <= 12) {
            if (idx == 1) { banks[1].r8_12[n - 8] = v; return; }
            r[n] = v; return;
        }
        if (n == 13 || n == 14) {
            if (idx == 0 || idx == 6) { r[n] = v; return; }
            Bank& b = banks[idx];
            if (n == 13) b.r13 = v; else b.r14 = v;
            return;
        }
        r[n] = v;
    }
    uint32_t get_user_reg(int n) const { return r[n]; }
    void set_user_reg(int n, uint32_t v) { r[n] = v; }

    bool cond(uint32_t c) const {
        bool n = cpsr.n(), z = cpsr.z(), cc = cpsr.c(), v = cpsr.v();
        switch (c) {
            case 0x0: return z;
            case 0x1: return !z;
            case 0x2: return cc;
            case 0x3: return !cc;
            case 0x4: return n;
            case 0x5: return !n;
            case 0x6: return v;
            case 0x7: return !v;
            case 0x8: return cc && !z;
            case 0x9: return !cc || z;
            case 0xA: return n == v;
            case 0xB: return n != v;
            case 0xC: return !z && (n == v);
            case 0xD: return z || (n != v);
            case 0xE: return true;
            case 0xF: return false;
        }
        return false;
    }
    void set_nz(uint32_t v) {
        cpsr.set_n((v >> 31) & 1);
        cpsr.set_z(v == 0);
    }
    void set_add_flags(uint32_t a, uint32_t b, uint32_t res, bool cin) {
        uint64_t full = (uint64_t)a + (uint64_t)b + (cin ? 1 : 0);
        cpsr.set_n((res >> 31) & 1);
        cpsr.set_z(res == 0);
        cpsr.set_c(full > 0xFFFFFFFFULL);
        cpsr.set_v(((a ^ res) & (b ^ res)) >> 31);
    }
    void set_sub_flags(uint32_t a, uint32_t b, uint32_t res, bool cin) {
        uint64_t sub = (uint64_t)b + (cin ? 0 : 1);
        cpsr.set_n((res >> 31) & 1);
        cpsr.set_z(res == 0);
        cpsr.set_c((uint64_t)a >= sub);
        cpsr.set_v(((a ^ b) & (a ^ res)) >> 31);
    }
    void take_exception(uint32_t vector, Mode new_mode, bool link) {
        int idx = mode_index(new_mode);
        banks[idx].spsr = cpsr.raw;
        /* ARM convention:
         *   IRQ/FIQ: LR = PC + 4, return via SUBS PC, LR, #4
         *   SWI/Undef: LR = PC,   return via MOVS PC, LR
         */
        if (new_mode == Mode::IRQ || new_mode == Mode::FIQ) {
            banks[idx].r14 = r[15] + 4;
        } else {
            banks[idx].r14 = r[15];
        }
        (void)link;
        cpsr.set_mode(new_mode);
        cpsr.set_t(false);
        cpsr.set_i(true);
        if (new_mode == Mode::FIQ) cpsr.set_f(true);
        r[15] = vector;
    }
    void take_data_abort() {
        int idx = mode_index(Mode::Abort);
        banks[idx].spsr = cpsr.raw;
        // ARM ARM: LR_abt = faulting_PC + 8 in both ARM and Thumb.
        // r[15] already advanced by fetch: I+4 (ARM) or I+2 (Thumb).
        uint32_t off = cpsr.t() ? 6u : 4u;
        banks[idx].r14 = r[15] + off;
        cpsr.set_mode(Mode::Abort);
        cpsr.set_t(false);
        cpsr.set_i(true);
        r[15] = 0x10;
    }

    void take_prefetch_abort() {
        int idx = mode_index(Mode::Abort);
        banks[idx].spsr = cpsr.raw;
        // ARM ARM: LR_abt = faulting_PC + 4.
        // r[15] already advanced by fetch: I+4 (ARM) or I+2 (Thumb).
        uint32_t off = cpsr.t() ? 2u : 0u;
        banks[idx].r14 = r[15] + off;
        cpsr.set_mode(Mode::Abort);
        cpsr.set_t(false);
        cpsr.set_i(true);
        r[15] = 0x0C;
    }
};

