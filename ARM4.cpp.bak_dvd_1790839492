// ============================================================
// stdin non-blocking
// ============================================================
static bool stdin_ready(int timeout_us) {
#ifdef ARM4_HAVE_SELECT
    fd_set fds;
    FD_ZERO(&fds);
    FD_SET(STDIN_FILENO, &fds);
    struct timeval tv;
    tv.tv_sec = timeout_us / 1000000;
    tv.tv_usec = timeout_us % 1000000;
    int r = select(STDIN_FILENO + 1, &fds, nullptr, nullptr, &tv);
    return r > 0;
#else
    (void)timeout_us;
    return false;
#endif
}

