class Emulator {
public:
    CPU cpu;
    Memory mem;
    PortManager ports;
    Config config;

    PL011_UART uart0{0x10009000, "UART0"};
    PL011_UART uart1{0x1000A000, "UART1"};
    PL011_UART uart2{0x1000B000, "UART2"};
    SP804_Timer timer0{0x101E2000, "TIMER0"};
    SP804_Timer timer1{0x101E3000, "TIMER1"};
    PL061_GPIO gpio0{0x10013000, "GPIO0"};
    PL061_GPIO gpio1{0x10014000, "GPIO1"};
    PL190_VIC  vic{0x10140000, "VIC"};
    VirtNet    net{0x10015000, "NET0"};
    VirtEth    eth{0x10016000, "ETH0"};
    VMCU       vmcu{0x10110000, "VMCU"};
    VirtLCD    lcd {0x10120000, "LCD"};
    CP15       cp15;
    MMU        mmu;

    uint32_t last_syscall = 0;

    uint64_t timer_period = 0;
    uint64_t timer_counter = 0;
    bool     irq_pending = false;
    bool     irq_enabled = true;

    bool trace = false;
    int  trace_limit = 0;

    bool history_enabled = false;
    static constexpr int HISTORY_SIZE = 64;
    TraceEntry history[HISTORY_SIZE];
    int history_pos = 0;

    bool pc_trap_enabled = false;
    uint32_t pc_trap_lo = 0x00000000;
    uint32_t pc_trap_hi = 0x00003FFF;

    bool loaded = false;
    size_t loaded_size = 0;

    void rebind() {
        mem.ports = &ports;
        mem.emu = this;
        g_cpu_ptr = &cpu;
        g_cp15_ptr = &cp15;
        g_mmu_ptr  = &mmu;
        mmu.attach(mem.data.data(), MEM_SIZE);
        // Связка CP15 <-> Cache для реальных c7-инвалидаций
        cp15.icache_ptr = &mem.icache;
        cp15.dcache_ptr = &mem.dcache;
        // Shared окно + DMA
        vmcu.attach_shared(mem.data.data() + 0x70000);
        vmcu.attach_arm4(mem.data.data(), MEM_SIZE);
        lcd.attach_mem(mem.data.data(), MEM_SIZE);
    }

    Emulator() { rebind(); }

    uint32_t do_lsl(uint32_t v, uint32_t n, bool& c) {
        if (n == 0) return v;
        if (n < 32) { c = (v >> (32 - n)) & 1; return v << n; }
        if (n == 32) { c = v & 1; return 0; }
        c = false; return 0;
    }
    uint32_t do_lsr(uint32_t v, uint32_t n, bool& c) {
        if (n == 0) return v;
        if (n < 32) { c = (v >> (n - 1)) & 1; return v >> n; }
        if (n == 32) { c = (v >> 31) & 1; return 0; }
        c = false; return 0;
    }
    uint32_t do_asr(uint32_t v, uint32_t n, bool& c) {
        int32_t sv = (int32_t)v;
        if (n == 0) return v;
        if (n < 32) { c = (v >> (n - 1)) & 1; return (uint32_t)(sv >> n); }
        c = (v >> 31) & 1;
        return (v & 0x80000000) ? 0xFFFFFFFF : 0;
    }
    uint32_t do_ror(uint32_t v, uint32_t n, bool& c) {
        n &= 31;
        if (n == 0) return v;
        c = (v >> (n - 1)) & 1;
        return ror_asm(v, n);
    }
    uint32_t do_rrx(uint32_t v, bool& c) {
        bool old_c = c; c = v & 1;
        return (v >> 1) | (old_c ? 0x80000000u : 0);
    }

    uint32_t fetch_arm() {
        uint32_t pc = cpu.r[15];
        cpu.r[15] = pc + 4;
        return mem.read32_ic(pc);
    }
    uint16_t fetch_thumb() {
        uint32_t pc = cpu.r[15];
        cpu.r[15] = pc + 2;
        return mem.read16_ic(pc);
    }

    uint32_t operand2_shift(uint32_t instr, bool& carry_out, bool immediate) {
        if (immediate) {
            uint32_t imm = instr & 0xFF;
            uint32_t rot = ((instr >> 8) & 0xF) * 2;
            carry_out = cpu.cpsr.c();
            if (rot == 0) return imm;
            uint32_t r = ror_asm(imm, rot);
            carry_out = (r >> 31) & 1;
            return r;
        }
        uint32_t rm = instr & 0xF;
        uint32_t type = (instr >> 5) & 0x3;
        uint32_t shift = (instr >> 7) & 0x1F;
        // ARM ARM: R15 as shift operand reads PC = I+8 (r[15] already = I+4)
        uint32_t v = (rm == 15) ? (cpu.r[15] + 4) : cpu.get_reg(rm);
        if ((instr >> 4) & 1) {
            uint32_t rs = (instr >> 8) & 0xF;
            shift = cpu.get_reg(rs) & 0xFF;
            if (shift == 0) { carry_out = cpu.cpsr.c(); return v; }
        }
        switch (type) {
            case 0: return do_lsl(v, shift, carry_out);
            case 1: return (shift == 0) ? do_lsr(v, 32, carry_out) : do_lsr(v, shift, carry_out);
            case 2: return (shift == 0) ? do_asr(v, 32, carry_out) : do_asr(v, shift, carry_out);
            case 3: return (shift == 0) ? do_rrx(v, carry_out) : do_ror(v, shift, carry_out);
        }
        carry_out = cpu.cpsr.c();
        return v;
    }

    void check_interrupts() {
        if (vic.irq_pending() && !cpu.cpsr.i()) {
            cpu.take_exception(0x18, Mode::IRQ, true);
            return;
        }
        if (vic.fiq_pending() && !cpu.cpsr.f()) {
            cpu.take_exception(0x1C, Mode::FIQ, true);
            return;
        }
        if (irq_pending && irq_enabled && !cpu.cpsr.i()) {
            cpu.take_exception(0x18, Mode::IRQ, true);
            irq_pending = false;
        }
    }
    void timer_tick() {
        if (timer_period == 0) return;
        timer_counter++;
        if (timer_counter >= timer_period) { timer_counter = 0; irq_pending = true; }
    }

    const char* annotate(uint32_t instr, uint32_t cpsr_raw) const {
        bool thumb = (cpsr_raw >> 5) & 1;
        if (thumb) return "Thumb";
        uint32_t op25 = (instr >> 25) & 0x7;
        if ((instr & 0x0FFFFFF0) == 0x012FFF10) return "BX";
        if (op25 == 0x5) return "B/BL";
        if (op25 == 0x4) return "LDM/STM";
        if ((instr & 0x0F000000) == 0x0F000000) return "SWI";
        if ((instr & 0x0E000000) == 0x0C000000) return "COP";
        if ((instr & 0x0FB00FF0) == 0x01000090) return "SWP";
        if ((instr & 0x0FC000F0) == 0x00000090) return "MUL";
        if ((instr & 0x0F8000F0) == 0x00800090) return "MULL";
        if ((instr & 0x0FBF0FFF) == 0x010F0000) return "MRS";
        if ((instr & 0x0DB0F000) == 0x0120F000) return "MSR";
        if ((instr & 0x00000090) == 0x00000090) return "HALF";
        if (op25 == 0x2) return "LDM/STM";
        if (op25 == 0x3) return "LDR/STR";
        if (op25 == 0x0 || op25 == 0x1) return "DP";
        return "?";
    }

    void record_history() {
        if (!history_enabled) return;
        TraceEntry& e = history[history_pos];
        e.cycles = cpu.cycles;
        e.pc = cpu.r[15];
        e.thumb = cpu.cpsr.t();
        e.instr = e.thumb ? (uint32_t)mem.read16(cpu.r[15])
                          : mem.read32(cpu.r[15]);
        e.cpsr = cpu.cpsr.raw;
        for (int i = 0; i < 16; i++) e.regs[i] = cpu.r[i];
        history_pos = (history_pos + 1) % HISTORY_SIZE;
    }

    void dump_history() {
        if (!history_enabled) {
            std::printf("\n[history] запись отключена\n\n");
            return;
        }
        std::printf("\n--- Последние %d инструкций ---\n", HISTORY_SIZE);
        for (int i = 0; i < HISTORY_SIZE; i++) {
            int idx = (history_pos + i) % HISTORY_SIZE;
            const TraceEntry& e = history[idx];
            if (e.cycles == 0) continue;
            std::printf("  [%llu] PC=0x%08X  instr=0x%08X  (%s)\n",
                        (unsigned long long)e.cycles, e.pc, e.instr,
                        annotate(e.instr, e.cpsr));
        }
        int last = (history_pos + HISTORY_SIZE - 1) % HISTORY_SIZE;
        const TraceEntry& e = history[last];
        std::printf("\n--- Регистры ---\n");
        for (int i = 0; i < 16; i++) {
            std::printf("R%-2d = 0x%08X", i, e.regs[i]);
            if (i % 4 == 3) std::printf("\n"); else std::printf("  ");
        }
        std::printf("CPSR = 0x%08X\n\n", e.cpsr);
    }

    void step() {
        cpu.cycles++;
        timer0.tick();
        timer1.tick();
        vic.set_source(12, uart0.irq_pending());
        vic.set_source(4,  timer0.irq_pending());
        vic.set_source(6,  gpio0.irq_pending());
        vic.set_source(14, net.irq_pending());
        vic.set_source(15, eth.irq_pending());
        net.tick();
        eth.tick();
        vmcu.tick();
        lcd.tick();
        vic.set_source(16, vmcu.irq_pending());
        vic.set_source(17, lcd.irq_pending());

        check_interrupts();
        if (cpu.halted) return;

        if (pc_trap_enabled) {
            uint32_t pc = cpu.r[15];
            if (pc < pc_trap_lo || pc > pc_trap_hi) {
                std::printf("\n[TRAP] PC вышел за пределы ROM: 0x%08X "
                            "(ROM: 0x%08X..0x%08X)\n",
                            pc, pc_trap_lo, pc_trap_hi);
                dump_history();
                cpu.halted = true;
                return;
            }
        }

        record_history();

        if (trace && trace_limit > 0) {
            uint32_t pc = cpu.r[15];
            uint32_t instr = cpu.cpsr.t()
                ? (uint32_t)mem.read16(pc) : mem.read32(pc);
            std::printf("  [%04d] PC=0x%08X  instr=0x%08X  (%s)\n",
                        (int)cpu.cycles, pc, instr, annotate(instr, cpu.cpsr.raw));
            trace_limit--;
        }

        mem.fault = false;
        uint32_t _instr;
        if (cpu.cpsr.t()) {
            _instr = fetch_thumb();
            if (mem.fault) {
                std::printf("[ABORT] Prefetch (Thumb) @ 0x%08X (PC=0x%08X) IFSR=0x%X IFAR=0x%08X\n",
                            mem.fault_addr, cpu.r[15], cp15.ifsr, cp15.ifar);
                cpu.take_prefetch_abort();
                mem.fault = false;
                return;
            }
            exec_thumb((uint16_t)_instr);
        } else {
            _instr = fetch_arm();
            if (mem.fault) {
                std::printf("[ABORT] Prefetch (ARM) @ 0x%08X (PC=0x%08X) IFSR=0x%X IFAR=0x%08X\n",
                            mem.fault_addr, cpu.r[15], cp15.ifsr, cp15.ifar);
                cpu.take_prefetch_abort();
                mem.fault = false;
                return;
            }
            exec_arm(_instr);
        }

        if (mem.fault) {
            std::printf("[ABORT] Data %s @ 0x%08X (PC=0x%08X) DFSR=0x%X DFAR=0x%08X\n",
                        mem.fault_write ? "write" : "read",
                        mem.fault_addr, cpu.r[15], cp15.dfsr, cp15.dfar);
            cpu.take_data_abort();
            mem.fault = false;
        }
    }

    // -------------- ARM dispatcher --------------
    void exec_arm(uint32_t instr) {
        uint32_t cond = (instr >> 28) & 0xF;
        if (!cpu.cond(cond)) return;

        if ((instr & 0x0FFFFFF0) == 0x012FFF10) { exec_branch(instr); return; }
        uint32_t bits_27_25 = (instr >> 25) & 0x7;
        if (bits_27_25 == 0x5) { exec_branch(instr); return; }
        if (bits_27_25 == 0x4) { exec_block_transfer(instr); return; }
        if ((instr & 0x0F000000) == 0x0F000000) { exec_swi(instr); return; }
        if ((instr & 0x0E000000) == 0x0C000000) { exec_coprocessor(instr); return; }

        uint32_t bits_27_26 = (instr >> 26) & 0x3;
        bool bit25 = (instr >> 25) & 1;
        bool bit4  = (instr >> 4)  & 1;

        if (bits_27_26 == 0x0) {
            if ((instr & 0x0FB00FF0) == 0x01000090) { exec_swap(instr); return; }
            if ((instr & 0x0FC000F0) == 0x00000090) { exec_multiply(instr); return; }
            if ((instr & 0x0F8000F0) == 0x00800090) { exec_multiply_long(instr); return; }
            if (!bit25 && (instr & 0x00000090) == 0x00000090 &&
                (instr & 0x00000060) != 0x00000000) {
                exec_halfword(instr); return;
            }
            if ((instr & 0x0FBF0FFF) == 0x010F0000) { exec_mrs(instr); return; }
            if ((instr & 0x0DB0F000) == 0x0120F000) { exec_msr(instr); return; }
            if ((instr & 0x0FB00000) == 0x03200000) { exec_msr(instr); return; }
            exec_data_processing(instr);
            return;
        }
        if (bits_27_26 == 0x1) { exec_load_store(instr); return; }
        if (bits_27_26 == 0x2) {
            if (!bit25 && bit4) { exec_halfword(instr); return; }
            exec_load_store(instr);
            return;
        }
    }

    void exec_data_processing(uint32_t instr) {
        uint32_t opcode = (instr >> 21) & 0xF;
        bool s = (instr >> 20) & 1;
        uint32_t rn = (instr >> 16) & 0xF;
        uint32_t rd = (instr >> 12) & 0xF;
        bool i = (instr >> 25) & 1;
        bool shift_carry = cpu.cpsr.c();
        uint32_t op2 = operand2_shift(instr, shift_carry, i);
        uint32_t a = (rn == 15) ? cpu.r[15] + 4 : cpu.get_reg(rn);
        uint32_t result = 0;
        bool write = true, log_op = false;

        switch (opcode) {
            case 0x0: result = a & op2;  log_op = true; break;
            case 0x1: result = a ^ op2;  log_op = true; break;
            case 0x2: result = a - op2;  if (s) cpu.set_sub_flags(a, op2, result, true); break;
            case 0x3: result = op2 - a;  if (s) cpu.set_sub_flags(op2, a, result, true); break;
            case 0x4: result = a + op2;  if (s) cpu.set_add_flags(a, op2, result, false); break;
            case 0x5: result = a + op2 + (cpu.cpsr.c()?1:0);
                      if (s) cpu.set_add_flags(a, op2, result, cpu.cpsr.c()); break;
            case 0x6: result = a - op2 - (cpu.cpsr.c()?0:1);
                      if (s) cpu.set_sub_flags(a, op2, result, cpu.cpsr.c()); break;
            case 0x7: result = op2 - a - (cpu.cpsr.c()?0:1);
                      if (s) cpu.set_sub_flags(op2, a, result, cpu.cpsr.c()); break;
            case 0x8: result = a & op2;  write = false; log_op = true; break;
            case 0x9: result = a ^ op2;  write = false; log_op = true; break;
            case 0xA: result = a - op2;  write = false; cpu.set_sub_flags(a, op2, result, true); break;
            case 0xB: result = a + op2;  write = false; cpu.set_add_flags(a, op2, result, false); break;
            case 0xC: result = a | op2;  log_op = true; break;
            case 0xD: result = op2;      log_op = true; break;
            case 0xE: result = a & ~op2; log_op = true; break;
            case 0xF: result = ~op2;     log_op = true; break;
        }

        if (write) {
            if (s && log_op) { cpu.set_nz(result); cpu.cpsr.set_c(shift_carry); }
            if (rd == 15) {
                if (s) cpu.cpsr.raw = cpu.banks[cpu.bank_idx()].spsr;
                cpu.r[15] = result & ~3u;
            } else cpu.set_reg(rd, result);
        } else {
            if (log_op) { cpu.set_nz(result); cpu.cpsr.set_c(shift_carry); }
        }
    }

    void exec_multiply(uint32_t instr) {
        bool a_bit = (instr >> 21) & 1;
        bool s = (instr >> 20) & 1;
        uint32_t rd = (instr >> 16) & 0xF;
        uint32_t rn = (instr >> 12) & 0xF;
        uint32_t rs = (instr >> 8) & 0xF;
        uint32_t rm = instr & 0xF;
        uint32_t result = cpu.get_reg(rm) * cpu.get_reg(rs);
        if (a_bit) result += cpu.get_reg(rn);
        cpu.set_reg(rd, result);
        if (s) { cpu.set_nz(result); cpu.cpsr.set_c(false); }
    }

    void exec_multiply_long(uint32_t instr) {
        bool u = (instr >> 22) & 1;
        bool a_bit = (instr >> 21) & 1;
        bool s = (instr >> 20) & 1;
        uint32_t rdhi = (instr >> 16) & 0xF;
        uint32_t rdlo = (instr >> 12) & 0xF;
        uint32_t rs = (instr >> 8) & 0xF;
        uint32_t rm = instr & 0xF;
        uint64_t result;
        if (u) result = (uint64_t)smul64((int32_t)cpu.get_reg(rm), (int32_t)cpu.get_reg(rs));
        else   result = umul64(cpu.get_reg(rm), cpu.get_reg(rs));
        if (a_bit) {
            uint64_t acc = ((uint64_t)cpu.get_reg(rdhi) << 32) | cpu.get_reg(rdlo);
            result += acc;
        }
        cpu.set_reg(rdhi, (uint32_t)(result >> 32));
        cpu.set_reg(rdlo, (uint32_t)(result & 0xFFFFFFFF));
        if (s) {
            cpu.cpsr.set_n((result >> 63) & 1);
            cpu.cpsr.set_z(result == 0);
            cpu.cpsr.set_c(false);
        }
    }

    void exec_swap(uint32_t instr) {
        bool b = (instr >> 22) & 1;
        uint32_t rn = (instr >> 16) & 0xF;
        uint32_t rd = (instr >> 12) & 0xF;
        uint32_t rm = instr & 0xF;
        uint32_t addr = cpu.get_reg(rn);
        dmb_ish();
        if (b) {
            uint8_t v = mem.read8(addr);
            mem.write8(addr, (uint8_t)cpu.get_reg(rm));
            cpu.set_reg(rd, v);
        } else {
            uint32_t v = mem.read32(addr & ~3u);
            mem.write32(addr & ~3u, cpu.get_reg(rm));
            cpu.set_reg(rd, v);
        }
        dmb_ish();
    }

    void exec_halfword(uint32_t instr) {
        bool p = (instr >> 24) & 1, u = (instr >> 23) & 1;
        bool i = (instr >> 22) & 1, w = (instr >> 21) & 1;
        bool l = (instr >> 20) & 1;
        uint32_t rn = (instr >> 16) & 0xF, rd = (instr >> 12) & 0xF;
        bool s = (instr >> 6) & 1, h = (instr >> 5) & 1;
        uint32_t offset = i ? (((instr >> 4) & 0xF0) | (instr & 0xF))
                            : cpu.get_reg(instr & 0xF);
        uint32_t base = (rn == 15) ? (cpu.r[15] + 4) : cpu.get_reg(rn);
        uint32_t addr = u ? (base + offset) : (base - offset);
        if (l) {
            uint32_t val = 0;
            if (!h && s)       val = (uint32_t)(int32_t)(int8_t)mem.read8(addr);
            else if (!h && !s) val = mem.read16(addr & ~1u);
            else if (h && s)   val = (uint32_t)(int32_t)(int16_t)mem.read16(addr & ~1u);
            cpu.set_reg(rd, val);
        } else {
            if (!h && !s) mem.write16(addr & ~1u, (uint16_t)cpu.get_reg(rd));
        }
        if (!p) cpu.set_reg(rn, addr);
        else if (w) cpu.set_reg(rn, addr);
    }

    void exec_load_store(uint32_t instr) {
        bool i = (instr >> 25) & 1, p = (instr >> 24) & 1;
        bool u = (instr >> 23) & 1, b = (instr >> 22) & 1;
        bool w = (instr >> 21) & 1, l = (instr >> 20) & 1;
        uint32_t rn = (instr >> 16) & 0xF, rd = (instr >> 12) & 0xF;
        uint32_t offset;
        if (i) {
            uint32_t rm = instr & 0xF;
            uint32_t type = (instr >> 5) & 0x3;
            uint32_t sh = (instr >> 7) & 0x1F;
            bool carry = cpu.cpsr.c();
            uint32_t v = cpu.get_reg(rm);
            switch (type) {
                case 0: offset = do_lsl(v, sh, carry); break;
                case 1: offset = (sh == 0) ? do_lsr(v, 32, carry) : do_lsr(v, sh, carry); break;
                case 2: offset = (sh == 0) ? do_asr(v, 32, carry) : do_asr(v, sh, carry); break;
                case 3: offset = (sh == 0) ? do_rrx(v, carry) : do_ror(v, sh, carry); break;
                default: offset = 0;
            }
        } else offset = instr & 0xFFF;
        uint32_t base = (rn == 15) ? (cpu.r[15] + 4) : cpu.get_reg(rn);
        uint32_t addr = u ? (base + offset) : (base - offset);
        if (l) {
            uint32_t val;
            if (b) val = mem.read8(addr);
            else {
                val = mem.read32(addr & ~3u);
                if (addr & 3) val = ror_asm(val, (addr & 3) * 8);
            }
            if (rd == 15) cpu.r[15] = val & ~3u;
            else cpu.set_reg(rd, val);
        } else {
            if (b) mem.write8(addr, (uint8_t)(cpu.get_reg(rd) & 0xFF));
            else   mem.write32(addr & ~3u, cpu.get_reg(rd));
        }
        if (!p && rn != 15) cpu.set_reg(rn, addr);
        else if (w && rn != 15) cpu.set_reg(rn, addr);
    }

    void exec_block_transfer(uint32_t instr) {
        bool p = (instr >> 24) & 1, u = (instr >> 23) & 1;
        bool s = (instr >> 22) & 1;
        bool w = (instr >> 21) & 1, l = (instr >> 20) & 1;
        uint32_t rn = (instr >> 16) & 0xF, reglist = instr & 0xFFFF;
        int count = 0;
        for (int i = 0; i < 16; i++) if (reglist & (1 << i)) count++;
        if (count == 0) return;
        uint32_t base = cpu.get_reg(rn);
        uint32_t addr;
        int step = 4;
        if (u && !p)       addr = base;
        else if (u && p)   addr = base + 4;
        else if (!u && !p) addr = base - 4*count + 4;
        else               addr = base - 4*count;
        uint32_t writeback = u ? (base + 4*count) : (base - 4*count);
        bool user_transfer = s && !(l && (reglist & 0x8000));
        bool exception_return = s && l && (reglist & 0x8000);
        if (l) {
            for (int i = 0; i < 16; i++) {
                if (reglist & (1 << i)) {
                    uint32_t v = mem.read32(addr & ~3u);
                    if (i == 15) cpu.r[15] = v & ~3u;
                    else if (user_transfer && (i == 13 || i == 14)) cpu.set_user_reg(i, v);
                    else cpu.set_reg(i, v);
                    addr += step;
                }
            }
            if (exception_return) cpu.cpsr.raw = cpu.banks[cpu.bank_idx()].spsr;
        } else {
            for (int i = 0; i < 16; i++) {
                if (reglist & (1 << i)) {
                    uint32_t v;
                    if (i == 15) v = cpu.r[15] + 4;
                    else if (user_transfer && (i == 13 || i == 14)) v = cpu.get_user_reg(i);
                    else v = cpu.get_reg(i);
                    mem.write32(addr & ~3u, v);
                    addr += step;
                }
            }
        }
        if (w && rn != 15) cpu.set_reg(rn, writeback);
    }

    void exec_branch(uint32_t instr) {
        if ((instr & 0x0FFFFFF0) == 0x012FFF10) {
            uint32_t rn = instr & 0xF;
            uint32_t target = cpu.get_reg(rn);
            if (target & 1) { cpu.cpsr.set_t(true);  cpu.r[15] = target & ~1u; }
            else            { cpu.cpsr.set_t(false); cpu.r[15] = target & ~3u; }
            return;
        }
        bool link = (instr >> 24) & 1;
        int32_t off = (int32_t)(instr & 0x00FFFFFF);
        if (off & 0x00800000) off |= 0xFF000000;
        off <<= 2;
        if (link) cpu.set_reg(14, cpu.r[15]);
        cpu.r[15] = cpu.r[15] + 4 + off;
        if (off == -8) cpu.halted = true;
    }

    void exec_mrs(uint32_t instr) {
        bool r = (instr >> 22) & 1;
        uint32_t rd = (instr >> 12) & 0xF;
        if (r && (cpu.cpsr.mode() == Mode::User || cpu.cpsr.mode() == Mode::System)) {
            cpu.take_exception(0x04, Mode::Undefined, false);
            return;
        }
        uint32_t v = r ? cpu.banks[cpu.bank_idx()].spsr : cpu.cpsr.raw;
        if (rd == 15) cpu.r[15] = v & ~3u;
        else cpu.set_reg(rd, v);
    }

    void exec_msr(uint32_t instr) {
        bool r = (instr >> 22) & 1;
        if (r && (cpu.cpsr.mode() == Mode::User || cpu.cpsr.mode() == Mode::System)) {
            cpu.take_exception(0x04, Mode::Undefined, false);
            return;
        }
        uint32_t field_mask = (instr >> 16) & 0xF;
        uint32_t value;
        bool immediate = (instr >> 25) & 1;
        if (immediate) {
            uint32_t imm = instr & 0xFF;
            uint32_t rot = ((instr >> 8) & 0xF) * 2;
            value = (rot == 0) ? imm : ror_asm(imm, rot);
        } else value = cpu.get_reg(instr & 0xF);
        uint32_t new_val = r ? cpu.banks[cpu.bank_idx()].spsr : cpu.cpsr.raw;
        uint32_t mask = 0;
        if (field_mask & 0x1) mask |= 0x000000FF;
        if (field_mask & 0x2) mask |= 0x0000FF00;
        if (field_mask & 0x4) mask |= 0x00FF0000;
        if (field_mask & 0x8) mask |= 0xFF000000;
        new_val = (new_val & ~mask) | (value & mask);
        if (r) cpu.banks[cpu.bank_idx()].spsr = new_val;
        else   cpu.cpsr.raw = new_val;
    }

    void exec_swi(uint32_t instr) {
        last_syscall = instr & 0x00FFFFFF;
        cpu.take_exception(0x08, Mode::Supervisor, false);
    }

    void exec_coprocessor(uint32_t instr) {
        uint32_t cp = (instr >> 8) & 0xF;
        bool l = (instr >> 20) & 1;
        uint32_t rd = (instr >> 12) & 0xF;
        bool bit4 = (instr >> 4) & 1;

        // MCR/MRC (bits 27-24=1110, bit4=1)
        if ((instr & 0x0F000000) == 0x0E000000 && bit4) {
            if (cp == 15) {
                uint32_t op1 = (instr >> 21) & 0x7;
                uint32_t crn = (instr >> 16) & 0xF;
                uint32_t op2 = (instr >> 5)  & 0x7;
                uint32_t crm =  instr        & 0xF;
                if (l) {
                    cpu.set_reg(rd, cp15.read(op1, crn, crm, op2));
                } else {
                    cp15.write(op1, crn, crm, op2, cpu.get_reg(rd));
                }
            }
            return;
        }
        // CDP — не поддерживаем
        cpu.take_exception(0x04, Mode::Undefined, false);
    }

    void exec_thumb(uint16_t instr) {
        uint32_t op = (instr >> 8) & 0xFF;

        if ((op & 0xF8) == 0x18) {
            bool i = (instr >> 10) & 1, sub = (instr >> 9) & 1;
            uint32_t rn = (instr >> 3) & 0x7, rd = instr & 0x7;
            uint32_t op2 = i ? ((instr >> 6) & 0x7) : cpu.get_reg((instr >> 6) & 0x7);
            uint32_t a = cpu.get_reg(rn);
            uint32_t r = sub ? (a - op2) : (a + op2);
            cpu.set_reg(rd, r); cpu.set_nz(r);
            if (sub) cpu.set_sub_flags(a, op2, r, true);
            else     cpu.set_add_flags(a, op2, r, false);
            return;
        }
        if ((op & 0xE0) == 0x00) {
            uint32_t type = (instr >> 11) & 0x3;
            uint32_t shift = (instr >> 6) & 0x1F;
            uint32_t rs = (instr >> 3) & 0x7, rd = instr & 0x7;
            bool c = cpu.cpsr.c();
            uint32_t v = cpu.get_reg(rs), r;
            switch (type) {
                case 0: r = do_lsl(v, shift, c); break;
                case 1: r = do_lsr(v, shift == 0 ? 32 : shift, c); break;
                case 2: r = do_asr(v, shift == 0 ? 32 : shift, c); break;
                default: r = v;
            }
            cpu.set_reg(rd, r); cpu.set_nz(r); cpu.cpsr.set_c(c);
            return;
        }
        if ((op & 0xE0) == 0x20) {
            uint32_t subop = (instr >> 11) & 0x3;
            uint32_t rd = (instr >> 8) & 0x7, imm = instr & 0xFF;
            uint32_t a = cpu.get_reg(rd), r;
            switch (subop) {
                case 0: cpu.set_reg(rd, imm); cpu.set_nz(imm); break;
                case 1: r = a - imm; cpu.set_sub_flags(a, imm, r, true); break;
                case 2: r = a + imm; cpu.set_reg(rd, r); cpu.set_add_flags(a, imm, r, false); break;
                case 3: r = a - imm; cpu.set_reg(rd, r); cpu.set_sub_flags(a, imm, r, true); break;
            }
            return;
        }
        if ((op & 0xFC) == 0x40) {
            uint32_t alu_op = (instr >> 6) & 0xF;
            uint32_t rs = (instr >> 3) & 0x7, rd = instr & 0x7;
            uint32_t a = cpu.get_reg(rd), b = cpu.get_reg(rs), r = 0;
            bool carry = cpu.cpsr.c();
            switch (alu_op) {
                case 0x0: r = a & b; cpu.set_reg(rd, r); cpu.set_nz(r); break;
                case 0x1: r = a ^ b; cpu.set_reg(rd, r); cpu.set_nz(r); break;
                case 0x2: r = do_lsl(a, b & 0xFF, carry); cpu.set_reg(rd, r); cpu.set_nz(r); cpu.cpsr.set_c(carry); break;
                case 0x3: r = do_lsr(a, (b & 0xFF) == 0 ? 32 : (b & 0xFF), carry); cpu.set_reg(rd, r); cpu.set_nz(r); cpu.cpsr.set_c(carry); break;
                case 0x4: r = do_asr(a, (b & 0xFF) == 0 ? 32 : (b & 0xFF), carry); cpu.set_reg(rd, r); cpu.set_nz(r); cpu.cpsr.set_c(carry); break;
                case 0x5: r = a + b + (cpu.cpsr.c()?1:0); cpu.set_reg(rd, r); cpu.set_add_flags(a, b, r, cpu.cpsr.c()); break;
                case 0x6: r = a - b - (cpu.cpsr.c()?0:1); cpu.set_reg(rd, r); cpu.set_sub_flags(a, b, r, cpu.cpsr.c()); break;
                case 0x7: r = do_ror(a, b & 0xFF, carry); cpu.set_reg(rd, r); cpu.set_nz(r); cpu.cpsr.set_c(carry); break;
                case 0x8: cpu.set_nz(a & b); break;
                case 0x9: r = 0 - b; cpu.set_reg(rd, r); cpu.set_sub_flags(0, b, r, true); break;
                case 0xA: cpu.set_sub_flags(a, b, a - b, true); break;
                case 0xB: cpu.set_add_flags(a, b, a + b, false); break;
                case 0xC: r = a | b; cpu.set_reg(rd, r); cpu.set_nz(r); break;
                case 0xD: r = a * b; cpu.set_reg(rd, r); cpu.set_nz(r); break;
                case 0xE: r = a & ~b; cpu.set_reg(rd, r); cpu.set_nz(r); break;
                case 0xF: r = ~b; cpu.set_reg(rd, r); cpu.set_nz(r); break;
            }
            return;
        }
        if ((op & 0xFC) == 0x44) {
            uint32_t subop = (instr >> 8) & 0x3;
            uint32_t rs = ((instr >> 6) & 0x8) | ((instr >> 3) & 0x7);
            uint32_t rd = (instr & 0x7) | ((instr >> 5) & 0x8);
            uint32_t a = cpu.get_reg(rd), b = cpu.get_reg(rs);
            switch (subop) {
                case 0: cpu.set_reg(rd, a + b); break;
                case 1: cpu.set_sub_flags(a, b, a - b, true); break;
                case 2:
                    if (rd == 15) {
                        if (b & 1) { cpu.cpsr.set_t(true);  cpu.r[15] = b & ~1u; }
                        else       { cpu.cpsr.set_t(false); cpu.r[15] = b & ~3u; }
                    } else cpu.set_reg(rd, b);
                    break;
                case 3:
                    if (b & 1) { cpu.cpsr.set_t(true);  cpu.r[15] = b & ~1u; }
                    else       { cpu.cpsr.set_t(false); cpu.r[15] = b & ~3u; }
                    break;
            }
            return;
        }
        if ((op & 0xF8) == 0x48) {
            uint32_t rd = (instr >> 8) & 0x7;
            uint32_t imm = (instr & 0xFF) * 4;
            uint32_t pc = (cpu.r[15] + 2) & ~3u;
            cpu.set_reg(rd, mem.read32(pc + imm));
            return;
        }
        if ((op & 0xF0) == 0x50) {
            uint32_t subop = (instr >> 9) & 0x7;
            uint32_t ro = (instr >> 6) & 0x7;
            uint32_t rb = (instr >> 3) & 0x7, rd = instr & 0x7;
            uint32_t addr = cpu.get_reg(rb) + cpu.get_reg(ro);
            switch (subop) {
                case 0: mem.write32(addr & ~3u, cpu.get_reg(rd)); break;
                case 1: mem.write16(addr & ~1u, (uint16_t)cpu.get_reg(rd)); break;
                case 2: mem.write8(addr, (uint8_t)cpu.get_reg(rd)); break;
                case 3: cpu.set_reg(rd, (uint32_t)(int32_t)(int8_t)mem.read8(addr)); break;
                case 4: cpu.set_reg(rd, mem.read32(addr & ~3u)); break;
                case 5: cpu.set_reg(rd, mem.read16(addr & ~1u)); break;
                case 6: cpu.set_reg(rd, mem.read8(addr)); break;
                case 7: cpu.set_reg(rd, (uint32_t)(int32_t)(int16_t)mem.read16(addr & ~1u)); break;
            }
            return;
        }
        if ((op & 0xF0) == 0x60) {
            bool l = (instr >> 11) & 1;
            uint32_t imm = ((instr >> 6) & 0x1F) * 4;
            uint32_t rb = (instr >> 3) & 0x7, rd = instr & 0x7;
            uint32_t addr = cpu.get_reg(rb) + imm;
            if (l) cpu.set_reg(rd, mem.read32(addr & ~3u));
            else   mem.write32(addr & ~3u, cpu.get_reg(rd));
            return;
        }
        if ((op & 0xF0) == 0x80) {
            bool l = (instr >> 11) & 1;
            uint32_t imm = ((instr >> 6) & 0x1F) * 2;
            uint32_t rb = (instr >> 3) & 0x7, rd = instr & 0x7;
            uint32_t addr = cpu.get_reg(rb) + imm;
            if (l) cpu.set_reg(rd, mem.read16(addr & ~1u));
            else   mem.write16(addr & ~1u, (uint16_t)cpu.get_reg(rd));
            return;
        }
        if ((op & 0xF0) == 0x90) {
            bool l = (instr >> 11) & 1;
            uint32_t rd = (instr >> 8) & 0x7;
            uint32_t imm = (instr & 0xFF) * 4;
            uint32_t sp = cpu.get_reg(13);
            if (l) cpu.set_reg(rd, mem.read32(sp + imm));
            else   mem.write32(sp + imm, cpu.get_reg(rd));
            return;
        }
        if ((op & 0xF0) == 0xA0) {
            bool sp = (instr >> 11) & 1;
            uint32_t rd = (instr >> 8) & 0x7;
            uint32_t imm = (instr & 0xFF) * 4;
            uint32_t pc = (cpu.r[15] + 2) & ~3u;
            cpu.set_reg(rd, sp ? (cpu.get_reg(13) + imm) : (pc + imm));
            return;
        }
        if ((op & 0xFF) == 0xB0) {
            uint32_t imm = (instr & 0x7F) * 4;
            bool sub = (instr >> 7) & 1;
            uint32_t sp = cpu.get_reg(13);
            if (sub) cpu.set_reg(13, sp - imm);
            else     cpu.set_reg(13, sp + imm);
            return;
        }
        if ((op & 0xF6) == 0xB4) {
            bool l = (instr >> 11) & 1, r = (instr >> 8) & 1;
            uint32_t reglist = instr & 0xFF;
            if (r) reglist |= (1 << 14);
            uint32_t sp = cpu.get_reg(13);
            if (l) {
                for (int i = 0; i < 8; i++) {
                    if (reglist & (1 << i)) {
                        cpu.set_reg(i, mem.read32(sp & ~3u));
                        sp += 4;
                    }
                }
                if (r) {
                    uint32_t pc = mem.read32(sp & ~3u);
                    sp += 4;
                    cpu.r[15] = pc & ~1u;
                }
                cpu.set_reg(13, sp);
            } else {
                int cnt = 0;
                for (int i = 0; i < 8; i++) if (reglist & (1 << i)) cnt++;
                if (r) cnt++;
                sp -= 4 * cnt;
                uint32_t addr = sp;
                for (int i = 0; i < 8; i++) {
                    if (reglist & (1 << i)) {
                        mem.write32(addr & ~3u, cpu.get_reg(i));
                        addr += 4;
                    }
                }
                if (r) mem.write32(addr & ~3u, cpu.r[14]);
                cpu.set_reg(13, sp);
            }
            return;
        }
        if ((op & 0xF0) == 0xC0) {
            bool l = (instr >> 11) & 1;
            uint32_t rb = (instr >> 8) & 0x7;
            uint32_t reglist = instr & 0xFF;
            uint32_t addr = cpu.get_reg(rb);
            for (int i = 0; i < 8; i++) {
                if (reglist & (1 << i)) {
                    if (l) cpu.set_reg(i, mem.read32(addr & ~3u));
                    else   mem.write32(addr & ~3u, cpu.get_reg(i));
                    addr += 4;
                }
            }
            cpu.set_reg(rb, addr);
            return;
        }
        if ((op & 0xF0) == 0xD0) {
            uint32_t cond = (instr >> 8) & 0xF;
            if (cond == 0xF) {
                last_syscall = instr & 0xFF;
                cpu.take_exception(0x08, Mode::Supervisor, false);
                return;
            }
            if (cond == 0xE) {
                cpu.take_exception(0x04, Mode::Undefined, false);
                return;
            }
            if (!cpu.cond(cond)) return;
            int32_t off = (int32_t)(int8_t)(instr & 0xFF);
            off <<= 1;
            cpu.r[15] = cpu.r[15] + 2 + off;
            return;
        }
        if ((op & 0xF8) == 0xE0) {
            int32_t off = (int32_t)(instr & 0x7FF);
            if (off & 0x400) off |= 0xFFFFF800;
            off <<= 1;
            uint32_t instr_addr = cpu.r[15] - 2;
            cpu.r[15] = cpu.r[15] + 2 + off;
            if (cpu.r[15] == instr_addr) cpu.halted = true;
            return;
        }
        if ((op & 0xF8) == 0xF0) {
            // BL, first half: LR = PC + SignExtend(imm11 << 12)
            uint32_t imm = instr & 0x7FF;
            if (imm & 0x400) imm |= 0xFFFFF800u;
            uint32_t PC = cpu.r[15] + 2;
            cpu.r[14] = PC + (imm << 12);
            return;
        }
        if ((op & 0xF8) == 0xF8) {
            // BL, second half: target = LR + PC + (imm11 << 1); LR = (I+4) | 1
            uint32_t imm = instr & 0x7FF;
            uint32_t PC = cpu.r[15] + 2;
            uint32_t LR = cpu.r[14];
            uint32_t target = LR + PC + (imm << 1);
            uint32_t ret = cpu.r[15] | 1;
            cpu.r[14] = ret;
            cpu.r[15] = target & ~1u;
            return;
        }
        cpu.take_exception(0x04, Mode::Undefined, false);
    }

    void run(int max_steps, bool trap = true) {
        pc_trap_enabled = trap;
        int steps = 0;
        while (!cpu.halted && steps < max_steps) { step(); steps++; }
        pc_trap_enabled = false;
        std::printf("Шагов: %d, cycles: %llu\n", steps, (unsigned long long)cpu.cycles);
    }

    void runloop(int steps_per_tick, int poll_us,
                 std::function<bool(const std::string&)> handler)
    {
        std::printf("[RUNLOOP] старт. steps/tick=%d, poll=%d мкс, 'stop' — выход\n",
                    steps_per_tick, poll_us);
        char line[4096];
        uint64_t ticks = 0;
        while (!cpu.halted) {
            int n = 0;
            while (n < steps_per_tick && !cpu.halted) { step(); n++; }
            ticks++;
            if (stdin_ready(poll_us)) {
                if (!std::fgets(line, sizeof(line), stdin)) break;
                size_t len = std::strlen(line);
                if (len > 0 && line[len-1] == '\n') line[len-1] = 0;
                std::string s = trim(line);
                if (s.empty()) continue;
                if (s == "stop" || s == "q" || s == "quit" || s == "s") break;
                bool should_exit = handler(s);
                if (should_exit) { cpu.halted = true; break; }
            }
            if (cpu.halted) break;
        }
        std::printf("[RUNLOOP] остановлен. ticks=%llu, cycles=%llu, PC=0x%08X\n",
                    (unsigned long long)ticks, (unsigned long long)cpu.cycles, cpu.r[15]);
    }

    bool applyConfig(bool do_load_bin) {
        cpu.banks[3].r13 = config.sp;
        pc_trap_lo = config.trap_lo;
        pc_trap_hi = config.trap_hi;
        history_enabled = config.history;
        mem.strict = config.strict;
        if (do_load_bin && !config.bin_path.empty()) return loadBin();
        return true;
    }

    bool loadBin() {
        if (config.bin_path.empty()) {
            std::printf("[CFG] bin_path не задан. Используй: load <путь> [addr]\n");
            return false;
        }
        if (!RomLoader::loadBinary(mem, config.bin_path.c_str(),
                                   config.load_addr, &loaded_size)) return false;
        RomLoader::printInfo(mem, config.load_addr);
        uint32_t entry = config.entry ? config.entry : config.load_addr;
        RomLoader::setupCPU(cpu, entry, config.sp);
        pc_trap_lo = config.trap_lo;
        pc_trap_hi = config.trap_hi;
        history_enabled = config.history;
        mem.strict = config.strict;
        loaded = true;
        cpu.halted = false;
        std::printf("[CFG] Entry=0x%08X SP=0x%08X Trap=[0x%08X..0x%08X]\n",
                    entry, config.sp, config.trap_lo, config.trap_hi);
        return true;
    }

    std::string saveConfig(std::string path) {
        if (looks_like_binary(path)) {
            std::printf("[CFG] ОШИБКА: '%s' похоже на .bin файл.\n", path.c_str());
            return "";
        }
        if (path.find('.') == std::string::npos) path += ".cfg";
        FILE* f = std::fopen(path.c_str(), "w");
        if (!f) { std::printf("[CFG] Не могу записать: %s\n", path.c_str()); return ""; }
        std::fprintf(f, "# ARM4 emulator config\n");
        std::fprintf(f, "bin=%s\n", config.bin_path.c_str());
        std::fprintf(f, "addr=0x%08X\n", config.load_addr);
        std::fprintf(f, "entry=0x%08X\n", config.entry);
        std::fprintf(f, "trap_lo=0x%08X\n", config.trap_lo);
        std::fprintf(f, "trap_hi=0x%08X\n", config.trap_hi);
        std::fprintf(f, "sp=0x%08X\n", config.sp);
        std::fprintf(f, "history=%d\n", config.history ? 1 : 0);
        std::fprintf(f, "strict=%d\n", config.strict ? 1 : 0);
        std::fprintf(f, "autoload=%d\n", config.autoload ? 1 : 0);
        std::fclose(f);
        std::printf("[CFG] Сохранено: %s\n", path.c_str());
        return path;
    }

    bool loadConfig(const char* path) {
        FILE* f = std::fopen(path, "r");
        if (!f) return false;
        char line[1024];
        Config c = config;
        while (std::fgets(line, sizeof(line), f)) {
            std::string s = trim(line);
            if (s.empty() || s[0] == '#' || s[0] == ';') continue;
            size_t eq = s.find('=');
            if (eq == std::string::npos) continue;
            std::string key = trim(s.substr(0, eq));
            std::string val = trim(s.substr(eq + 1));
            if      (key == "bin")      c.bin_path  = val;
            else if (key == "addr")     c.load_addr = parse_u32(val.c_str());
            else if (key == "entry")    c.entry     = parse_u32(val.c_str());
            else if (key == "trap_lo")  c.trap_lo   = parse_u32(val.c_str());
            else if (key == "trap_hi")  c.trap_hi   = parse_u32(val.c_str());
            else if (key == "sp")       c.sp        = parse_u32(val.c_str());
            else if (key == "history")  c.history   = (val != "0");
            else if (key == "strict")   c.strict    = (val != "0");
            else if (key == "autoload") c.autoload  = (val != "0");
        }
        std::fclose(f);
        config = c;
        return true;
    }

    void showConfig() const {
        std::printf("--- Config ---\n");
        std::printf("  bin      = %s\n", config.bin_path.empty() ? "(нет)" : config.bin_path.c_str());
        std::printf("  addr     = 0x%08X\n", config.load_addr);
        std::printf("  entry    = 0x%08X\n", config.entry);
        std::printf("  trap_lo  = 0x%08X\n", config.trap_lo);
        std::printf("  trap_hi  = 0x%08X\n", config.trap_hi);
        std::printf("  sp       = 0x%08X\n", config.sp);
        std::printf("  history  = %d\n", config.history ? 1 : 0);
        std::printf("  strict   = %d\n", config.strict ? 1 : 0);
        std::printf("  autoload = %d\n", config.autoload ? 1 : 0);
        std::printf("  loaded   = %d (%zu байт)\n", loaded ? 1 : 0, loaded_size);
    }

    void wipeConfig() {
        config = Config();
        loaded = false;
        loaded_size = 0;
        history_enabled = false;
        mem.strict = false;
        pc_trap_lo = 0;
        pc_trap_hi = 0x3FFF;
        std::printf("[CFG] Конфиг сброшен\n");
    }
};

