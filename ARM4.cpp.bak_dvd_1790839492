class Memory {
public:
    std::vector<uint8_t> data;
    Cache icache{"I"};
    Cache dcache{"D"};
    PortManager* ports = nullptr;
    Emulator* emu = nullptr;
    bool     strict     = false;
    bool     fault      = false;
    uint32_t fault_addr = 0;
    bool     fault_write = false;

    Memory() : data(MEM_SIZE, 0) {
        icache.attach(data.data(), MEM_SIZE);
        dcache.attach(data.data(), MEM_SIZE);
    }

    inline bool valid32(uint32_t a) const { return a <= MEM_SIZE - 4; }
    inline bool valid16(uint32_t a) const { return a <= MEM_SIZE - 2; }
    inline bool valid8 (uint32_t a) const { return a <  MEM_SIZE; }
    inline void flag_fault(uint32_t a, bool w) {
        if (strict && !fault) { fault = true; fault_addr = a; fault_write = w; }
    }

    uint32_t read32(uint32_t a);
    uint16_t read16(uint32_t a);
    uint8_t  read8 (uint32_t a);
    uint32_t read32_ic(uint32_t a);
    uint16_t read16_ic(uint32_t a);
    void     write32(uint32_t a, uint32_t v);
    void     write16(uint32_t a, uint16_t v);
    void     write8 (uint32_t a, uint8_t v);

    void load(const uint8_t* src, size_t n, uint32_t addr) {
        if (addr + n > MEM_SIZE) n = MEM_SIZE - addr;
        std::memcpy(&data[addr], src, n);
    }
};

