#!/usr/bin/env python3
"""epcc.py v0.3 — C-подмножество -> байткод EP32cm.

Новое в v0.3:
  * float-тип: float x = 3.14;  x = x * 2.0;
  * арифметика float через FPU (FADD/FSUB/FMUL/FDIV/FSQRT)
  * сравнения через FCMP + J-инструкции
  * (int)expr / (float)expr — явные конверсии
  * автоматическая конверсия int->float в смешанных выражениях
  * всё из v0.2: массивы, функции, 32-бит константы, gfx builtins
"""

import sys, re, struct
from epc_asm import Emitter

# ============ LEXER ============
def tokenize(src):
    src = re.sub(r'//[^\n]*', '', src)
    src = re.sub(r'/\*.*?\*/', '', src, flags=re.DOTALL)
    pat = re.compile(
        r'\s+'
        r'|0[xX][0-9a-fA-F]+'
        r'|\d+\.\d+([eE][+-]?\d+)?'
        r'|\d+([eE][+-]?\d+)?'
        r'|[A-Za-z_]\w*'
        r'|<<|>>|<=|>=|==|!=|&&|\|\|'
        r'|[-+*/%&|^<>=!(){}\[\],;]'
    )
    out = []
    for m in pat.finditer(src):
        t = m.group()
        if not t[0].isspace():
            out.append(t)
    out.append('<EOF>')
    return out

def is_float_lit(t):
    return bool(re.match(r'^\d+\.\d+', t)) or bool(re.match(r'^\d+[eE]', t))

# ============ PARSER ============
class P:
    def __init__(self, toks):
        self.t = toks
        self.i = 0

    def peek(self):
        return self.t[self.i]

    def eat(self, want=None):
        t = self.t[self.i]
        if want is not None and t != want:
            raise SyntaxError(f'expected {want!r}, got {t!r}')
        self.i += 1
        return t

    def at(self, *vals):
        return self.peek() in vals

    def program(self):
        items = []
        while self.peek() != '<EOF>':
            items.append(self.toplevel())
        return ('prog', items)

    def toplevel(self):
        if self.peek() not in ('int', 'float'):
            return self.stmt()
        typ = self.eat()
        name = self.eat()
        if self.at('('):
            self.eat('(')
            params = []
            if not self.at(')'):
                while True:
                    ptype = self.eat()
                    if ptype not in ('int', 'float'):
                        raise SyntaxError('param type')
                    pname = self.eat()
                    params.append((ptype, pname))
                    if not self.at(','):
                        break
                    self.eat(',')
            self.eat(')')
            body = self.block()
            return ('func', name, typ, params, body)
        if self.at('['):
            self.eat('[')
            n = int(self.eat(), 0)
            self.eat(']')
            self.eat(';')
            return ('decl_array', name, typ, n)
        init = None
        if self.at('='):
            self.eat('=')
            init = self.expr()
        self.eat(';')
        return ('decl', name, typ, init)

    def block(self):
        self.eat('{')
        body = []
        while self.peek() != '}':
            body.append(self.stmt())
        self.eat('}')
        return ('block', body)

    def stmt(self):
        t = self.peek()
        if t == '{':
            return self.block()
        if t in ('int', 'float'):
            return self.local_decl()
        if t == 'if':
            return self.if_stmt()
        if t == 'while':
            return self.while_stmt()
        if t == 'for':
            return self.for_stmt()
        if t == 'return':
            self.eat('return')
            e = None if self.at(';') else self.expr()
            self.eat(';')
            return ('return', e)
        e = self.expr()
        self.eat(';')
        return ('expr', e)

    def local_decl(self):
        typ = self.eat()
        name = self.eat()
        if self.at('['):
            self.eat('[')
            n = int(self.eat(), 0)
            self.eat(']')
            self.eat(';')
            return ('decl_array', name, typ, n)
        init = None
        if self.at('='):
            self.eat('=')
            init = self.expr()
        self.eat(';')
        return ('decl', name, typ, init)

    def if_stmt(self):
        self.eat('if')
        self.eat('(')
        c = self.expr()
        self.eat(')')
        th = self.stmt()
        el = None
        if self.at('else'):
            self.eat('else')
            el = self.stmt()
        return ('if', c, th, el)

    def while_stmt(self):
        self.eat('while')
        self.eat('(')
        c = self.expr()
        self.eat(')')
        return ('while', c, self.stmt())

    def for_stmt(self):
        self.eat('for')
        self.eat('(')
        init = None
        if not self.at(';'):
            init = self.stmt()
        else:
            self.eat(';')
        cond = None
        if not self.at(';'):
            cond = self.expr()
        self.eat(';')
        step = None
        if not self.at(')'):
            step = self.expr()
        self.eat(')')
        return ('for', init, cond, step, self.stmt())

    def expr(self):
        return self.assign()

    def assign(self):
        save = self.i
        try:
            lhs = self.lval()
            if self.at('='):
                self.eat('=')
                rhs = self.assign()
                return ('assign', lhs, rhs)
            self.i = save
        except Exception:
            self.i = save
        return self.binary(0)

    def lval(self):
        name = self.eat()
        if not re.match(r'^[A-Za-z_]\w*$', name):
            raise SyntaxError(f'lval: {name!r}')
        if self.at('['):
            self.eat('[')
            idx = self.expr()
            self.eat(']')
            return ('index', name, idx)
        return ('id', name)

    PRE = {
        '||': 1, '&&': 2, '|': 3, '^': 4, '&': 5,
        '==': 6, '!=': 6, '<': 7, '>': 7, '<=': 7, '>=': 7,
        '<<': 8, '>>': 8, '+': 9, '-': 9, '*': 10, '/': 10, '%': 10
    }

    def binary(self, minp):
        left = self.unary()
        while True:
            op = self.peek()
            p = self.PRE.get(op, -1)
            if p < minp:
                break
            self.eat()
            right = self.binary(p + 1)
            left = ('bin', op, left, right)
        return left

    def unary(self):
        if self.at('-', '!', '~'):
            op = self.eat()
            return ('un', op, self.unary())
        if self.at('('):
            if self.i + 1 < len(self.t) and self.t[self.i+1] in ('int', 'float') \
               and self.i + 2 < len(self.t) and self.t[self.i+2] == ')':
                self.eat('(')
                tgt = self.eat()
                self.eat(')')
                e = self.unary()
                return ('cast', tgt, e)
        return self.postfix()

    def postfix(self):
        e = self.prim()
        while self.at('['):
            if e[0] != 'id':
                raise SyntaxError('only a[i] indexing supported')
            self.eat('[')
            idx = self.expr()
            self.eat(']')
            e = ('index', e[1], idx)
        return e

    def prim(self):
        t = self.eat()
        if re.match(r'^0[xX][0-9a-fA-F]+$', t):
            return ('num', int(t, 0), 'int')
        if is_float_lit(t):
            return ('fnum', float(t))
        if re.match(r'^\d+$', t):
            return ('num', int(t, 0), 'int')
        if t == '(':
            e = self.expr()
            self.eat(')')
            return e
        if re.match(r'^[A-Za-z_]\w*$', t):
            if self.at('('):
                self.eat('(')
                args = []
                if not self.at(')'):
                    args.append(self.expr())
                    while self.at(','):
                        self.eat(',')
                        args.append(self.expr())
                self.eat(')')
                return ('call', t, args)
            return ('id', t)
        raise SyntaxError(f'unexpected {t!r}')

# ============ CODEGEN ============
GLOBAL_BASE = 0x4000
STACK_TOP   = 0x7FF0

class CG:
    def __init__(self):
        self.e = Emitter()
        self.g = {}
        self.g_next = 0
        self.funcs = {}
        self.label_n = 0
        self.cur_func_ret = None
        self.float_pool = {}

    def lbl(self, p='L'):
        self.label_n += 1
        return f'{p}{self.label_n}'

    def alloc(self, name, typ='int'):
        if name in self.g:
            return self.g[name][0]
        off = self.g_next
        self.g[name] = (off, typ)
        self.g_next += 1
        return off

    def alloc_array(self, name, n, typ='int'):
        if name in self.g:
            return self.g[name][0]
        off = self.g_next
        self.g[name] = (off, typ)
        self.g_next += n
        return off

    def type_of(self, name):
        if name not in self.g:
            return 'int'
        return self.g[name][1]

    def emit_const(self, reg, val):
        v = val & 0xFFFFFFFF
        hi = (v >> 20) & 0xFFF
        lo = v & 0xFFFFF
        if hi == 0:
            self.e.movi(reg, lo)
        else:
            self.e.movi(reg, hi)
            self.e.shli(reg, 20)
            if lo:
                self.e.ori(reg, lo)

    def offset_of(self, name):
        if name not in self.g:
            raise NameError(f'undefined variable: {name}')
        return self.g[name][0] * 4

    def push_int(self):
        self.e.subi(7, 4)
        self.e.stl(7, 0, 0)

    def pop_int(self, dst):
        self.e.ldl(dst, 7, 0)
        self.e.addi(7, 4)

    def push_float(self):
        self.e.subi(7, 4)
        self.e.fstl(7, 0, 0)

    def pop_float(self, fd):
        self.e.fldl(fd, 7, 0)
        self.e.addi(7, 4)

    def pool_float(self, value):
        bits = struct.unpack('<I', struct.pack('<f', value))[0]
        if bits in self.float_pool:
            return self.float_pool[bits]
        off = self.g_next
        self.g_next += 1
        self.float_pool[bits] = (off, bits)
        return (off, bits)

    def gen(self, n):
        k = n[0]
        if k == 'num':
            self.emit_const(0, n[1])
            return 'int'
        if k == 'fnum':
            # ИСПРАВЛЕНИЕ: inline-эмиссия float-константы через безопасный scratch в RAM.
            # 0x7FFC находится сразу над STACK_TOP (0x7FF0), гарантированно является RAM 
            # и не попадает в диапазон трапов [0x00000000..0x00003FFF].
            bits = struct.unpack('<I', struct.pack('<f', n[1]))[0]
            self.emit_const(0, bits)
            self.e.stl(6, 0, 0x7FFC)
            self.e.fldl(0, 6, 0x7FFC)
            return 'float'
        if k == 'id':
            name = n[1]
            off = self.offset_of(name)
            t = self.type_of(name)
            if t == 'float':
                self.e.fldl(0, 6, off)
                return 'float'
            else:
                self.e.ldl(0, 6, off)
                return 'int'
        if k == 'index':
            name, idx = n[1], n[2]
            base = self.offset_of(name)
            self.gen(idx)
            self.e.shli(0, 2)
            self.e.addi(0, base)
            self.e.add(1, 6, 0)
            self.e.ldl(0, 1, 0)
            return 'int'
        if k == 'cast':
            tgt, e = n[1], n[2]
            src = self.gen(e)
            if tgt == src:
                return tgt
            if tgt == 'float':
                self.e.fcvti(0, 0)
                return 'float'
            else:
                self.e.fcvtf(0, 0)
                return 'int'
        if k == 'assign':
            lhs, rhs = n[1], n[2]
            if lhs[0] == 'id':
                name = lhs[1]
                vt = self.type_of(name)
                rt = self.gen(rhs)
                if vt == 'float' and rt == 'int':
                    self.e.fcvti(0, 0)
                    rt = 'float'
                elif vt == 'int' and rt == 'float':
                    self.e.fcvtf(0, 0)
                    rt = 'int'
                off = self.offset_of(name)
                if vt == 'float':
                    self.e.fstl(6, 0, off)
                else:
                    self.e.stl(6, 0, off)
                return vt
            if lhs[0] == 'index':
                name, idx = lhs[1], lhs[2]
                rt = self.gen(rhs)
                if rt == 'float':
                    self.e.fcvtf(0, 0)
                self.push_int()
                self.gen(idx)
                self.e.shli(0, 2)
                self.e.addi(0, self.offset_of(name))
                self.e.add(1, 6, 0)
                self.pop_int(0)
                self.e.stl(1, 0, 0)
                return 'int'
            raise ValueError(f'assign lhs: {lhs[0]}')
        if k == 'un':
            op, x = n[1], n[2]
            t = self.gen(x)
            if op == '-':
                if t == 'float':
                    self.e.fneg(0, 0)
                else:
                    self.e.movi(1, 0)
                    self.e.sub(0, 1, 0)
            elif op == '~':
                if t == 'float':
                    raise ValueError('~float')
                self.e.not_(0, 0)
            elif op == '!':
                if t == 'float':
                    self.e.fldz(1)
                    self.e.fcmp(0, 1)
                else:
                    self.e.movi(1, 0)
                    self.e.cmp(0, 1)
                t_lbl = self.lbl('nt')
                e_lbl = self.lbl('ne')
                self.e.jz(t_lbl)
                self.e.movi(0, 0)
                self.e.jmp(e_lbl)
                self.e.label(t_lbl)
                self.e.movi(0, 1)
                self.e.label(e_lbl)
                return 'int'
            return t
        if k == 'bin':
            op, l, r = n[1], n[2], n[3]

            if op == '&&':
                lt = self.gen(l)
                if lt == 'float':
                    self.e.fcvtf(0, 0)
                self.e.cmpi(0, 0)
                f = self.lbl('af')
                e = self.lbl('ae')
                self.e.jz(f)
                rt = self.gen(r)
                if rt == 'float':
                    self.e.fcvtf(0, 0)
                self.e.cmpi(0, 0)
                self.e.jz(f)
                self.e.movi(0, 1)
                self.e.jmp(e)
                self.e.label(f)
                self.e.movi(0, 0)
                self.e.label(e)
                return 'int'
            if op == '||':
                lt = self.gen(l)
                if lt == 'float':
                    self.e.fcvtf(0, 0)
                self.e.cmpi(0, 0)
                t = self.lbl('ot')
                e = self.lbl('oe')
                self.e.jnz(t)
                rt = self.gen(r)
                if rt == 'float':
                    self.e.fcvtf(0, 0)
                self.e.cmpi(0, 0)
                self.e.jnz(t)
                self.e.movi(0, 0)
                self.e.jmp(e)
                self.e.label(t)
                self.e.movi(0, 1)
                self.e.label(e)
                return 'int'

            lt = self.gen(l)
            if lt == 'float':
                self.push_float()
            else:
                self.push_int()
            rt = self.gen(r)

            common = 'float' if (lt == 'float' or rt == 'float') else 'int'

            if common == 'float' and rt == 'int':
                self.e.fcvti(0, 0)
                rt = 'float'

            if common == 'float':
                if lt == 'int':
                    self.pop_int(1)
                    self.e.fcvti(1, 1)
                else:
                    self.pop_float(1)
            else:
                self.pop_int(1)

            if common == 'float':
                if op == '+':
                    self.e.fadd(0, 1, 0)
                elif op == '-':
                    self.e.fsub(0, 1, 0)
                elif op == '*':
                    self.e.fmul(0, 1, 0)
                elif op == '/':
                    self.e.fdiv(0, 1, 0)
                elif op in ('==', '!=', '<', '>', '<=', '>='):
                    self.e.fcmp(1, 0)
                    t = self.lbl('ct')
                    e = self.lbl('ce')
                    jt = {'==': 'jz', '!=': 'jnz', '<': 'jlt', '>': 'jgt', '<=': 'jle', '>=': 'jge'}[op]
                    getattr(self.e, jt)(t)
                    self.e.movi(0, 0)
                    self.e.jmp(e)
                    self.e.label(t)
                    self.e.movi(0, 1)
                    self.e.label(e)
                    return 'int'
                else:
                    raise ValueError(f'float op {op}')
                return 'float'
            else:
                if op == '+':
                    self.e.add(0, 1, 0)
                elif op == '-':
                    self.e.sub(0, 1, 0)
                elif op == '*':
                    self.e.mul(0, 1, 0)
                elif op == '/':
                    self.e.div(0, 1, 0)
                elif op == '%':
                    self.e.mod(0, 1, 0)
                elif op == '&':
                    self.e.and_(0, 1, 0)
                elif op == '|':
                    self.e.or_(0, 1, 0)
                elif op == '^':
                    self.e.xor(0, 1, 0)
                elif op == '<<':
                    self.e.shl(0, 1, 0)
                elif op == '>>':
                    self.e.shr(0, 1, 0)
                elif op in ('==', '!=', '<', '>', '<=', '>='):
                    self.e.cmp(1, 0)
                    t = self.lbl('ct')
                    e = self.lbl('ce')
                    jt = {'==': 'jz', '!=': 'jnz', '<': 'jlt', '>': 'jgt', '<=': 'jle', '>=': 'jge'}[op]
                    getattr(self.e, jt)(t)
                    self.e.movi(0, 0)
                    self.e.jmp(e)
                    self.e.label(t)
                    self.e.movi(0, 1)
                    self.e.label(e)
                    return 'int'
                else:
                    raise ValueError(f'op {op}')
                return 'int'
        if k == 'call':
            return self.gen_call(n[1], n[2])
        raise ValueError(f'gen: {k}')

    def gen_call(self, name, args):
        if name == 'out':
            self.gen(args[1])
            port = args[0][1] if args[0][0] == 'num' else 0
            self.e.out(port & 0xF, 0)
            return 'int'
        if name == 'in':
            port = args[0][1] if args[0][0] == 'num' else 0
            self.e.in_(0, port & 0xF)
            return 'int'
        if name == 'irq':
            nn = args[0][1] if args[0][0] == 'num' else 0
            self.e.irq(nn & 0xF)
            self.e.movi(0, 0)
