            self.e.movi(1, 5)
            self.e.shl(0, 0, 1)
            self.pop_int(1)
            self.e.or_(0, 1, 0)
            self.push_int()
            self.gen(args[2])
            self.pop_int(1)
            self.e.or_(0, 1, 0)
            return 'int'

        if name not in self.funcs:
            raise NameError(f'unknown function: {name}')
        ret_type, params, arg_slots, body = self.funcs[name]
        if len(args) != len(params):
            raise ValueError(f'{name}: expected {len(params)} args, got {len(args)}')
        for i, a in enumerate(args):
            rt = self.gen(a)
            ptype = params[i][0]
            if ptype == 'float' and rt == 'int':
                self.e.fcvti(0, 0)
                self.e.fstl(6, 0, arg_slots[i] * 4)
            elif ptype == 'int' and rt == 'float':
                self.e.fcvtf(0, 0)
                self.e.stl(6, 0, arg_slots[i] * 4)
            elif ptype == 'float':
                self.e.fstl(6, 0, arg_slots[i] * 4)
            else:
                self.e.stl(6, 0, arg_slots[i] * 4)
        self.e.call(name)
        return ret_type

    def stmt(self, n):
        k = n[0]
        if k == 'block':
            for s in n[1]:
                self.stmt(s)
            return
        if k == 'decl':
            name, typ, init = n[1], n[2], n[3]
            self.alloc(name, typ)
            if init is not None:
                self.gen(init)
                off = self.offset_of(name)
                if typ == 'float':
                    self.e.fstl(6, 0, off)
                else:
                    self.e.stl(6, 0, off)
            return
        if k == 'decl_array':
            self.alloc_array(n[1], n[3], n[2])
            return
        if k == 'expr':
            self.gen(n[1])
            return
        if k == 'return':
            if n[1] is not None:
                rt = self.gen(n[1])
                if self.cur_func_ret_type == 'float' and rt == 'int':
                    self.e.fcvti(0, 0)
            else:
                self.e.movi(0, 0)
            self.e.jmp(self.cur_func_ret)
            return
        if k == 'if':
            cond, th, el = n[1], n[2], n[3]
            eLbl = self.lbl('el')
            end = self.lbl('ie')
            ct = self.gen(cond)
            if ct == 'float':
                self.e.fldz(1)
                self.e.fcmp(0, 1)
                self.e.jz(eLbl if el else end)
            else:
                self.e.cmpi(0, 0)
                self.e.jz(eLbl if el else end)
            self.stmt(th)
            if el:
                self.e.jmp(end)
                self.e.label(eLbl)
                self.stmt(el)
            self.e.label(end)
            return
        if k == 'while':
            cond, body = n[1], n[2]
            top = self.lbl('wt')
            end = self.lbl('we')
            self.e.label(top)
            ct = self.gen(cond)
            if ct == 'float':
                self.e.fldz(1)
                self.e.fcmp(0, 1)
                self.e.jz(end)
            else:
                self.e.cmpi(0, 0)
                self.e.jz(end)
            self.stmt(body)
            self.e.jmp(top)
            self.e.label(end)
            return
        if k == 'for':
            init, cond, step, body = n[1], n[2], n[3], n[4]
            if init:
                self.stmt(init)
            top = self.lbl('ft')
            end = self.lbl('fe')
            self.e.label(top)
            if cond:
                ct = self.gen(cond)
                if ct == 'float':
                    self.e.fldz(1)
                    self.e.fcmp(0, 1)
                    self.e.jz(end)
                else:
                    self.e.cmpi(0, 0)
                    self.e.jz(end)
            self.stmt(body)
            if step:
                self.gen(step)
            self.e.jmp(top)
            self.e.label(end)
            return
        raise ValueError(f'stmt: {k}')

    def collect(self, item):
        if item[0] == 'func':
            name, ret_type, params, body = item[1], item[2], item[3], item[4]
            arg_slots = []
            for ptype, pname in params:
                arg_slots.append(self.alloc(f'${name}${pname}', ptype))
            self.funcs[name] = (ret_type, params, arg_slots, body)

    def gen_program(self, ast):
        for item in ast[1]:
            if item[0] == 'func':
                self.collect(item)
        self.e.movi(6, GLOBAL_BASE)
        self.e.movi(7, STACK_TOP)

        # 1) Сначала пройти по ast и собрать все float-литералы в пул,
        #    чтобы знать их слоты.
        saved_words = len(self.e.words)   # запомним позицию — код инициализации
        # Обходим AST и генерим main-body, попутно собирая пул.
        # Но код пула должен быть ДО main-body. Значит:
        #  - сгенерим main-body во временный emitter
        #  - потом соберём пул в основной emitter
        #  - потом перенесём main-body
        # Проще: сделаем prepass, который соберёт все float-константы.

        # prepass: рекурсивно обойти дерево, найти все fnum
        def collect_floats(node):
            if not isinstance(node, tuple): return
            if node[0] == 'fnum':
                self.pool_float(node[1])
            for x in node[1:]:
                if isinstance(x, tuple): collect_floats(x)
                elif isinstance(x, list):
                    for y in x: collect_floats(y)

        for item in ast[1]:
            collect_floats(item)

        # 2) теперь генерим инициализацию пула
        for bits, (off, _) in list(self.float_pool.items()):
            self.emit_const(0, bits)
            self.e.stl(6, 0, off * 4)

        # 3) main-body
        for item in ast[1]:
            if item[0] != 'func':
                self.stmt(item)
        for item in ast[1]:
            if item[0] != 'func':
                continue
            name, ret_type, params, body = item[1], item[2], item[3], item[4]
            ret_lbl = self.lbl(f'ret_{name}_')
            self.cur_func_ret = ret_lbl
            self.cur_func_ret_type = ret_type
            self.e.label(name)
            for (ptype, pname), slot in zip(params, self.funcs[name][2]):
                self.g[pname] = (slot, ptype)
            self.stmt(body)
            self.e.movi(0, 0)
            self.e.label(ret_lbl)
            self.e.ret()
        self.e.hlt()
        return self.e.hex()

# ============ CLI ============
def compile_src(src):
    toks = tokenize(src)
    ast = P(toks).program()
    cg = CG()
    return cg.gen_program(ast)

def main():
    if len(sys.argv) < 2:
        print('usage: python3 epcc.py <input.c> [output.hex]')
        return
    hex_out = compile_src(open(sys.argv[1]).read())
    if len(sys.argv) >= 3:
        open(sys.argv[2], 'w').write(hex_out + '\n')
        print(f'OK: {len(hex_out)//8} words -> {sys.argv[2]}')
    else:
        print(hex_out)

if __name__ == '__main__':
    main()
